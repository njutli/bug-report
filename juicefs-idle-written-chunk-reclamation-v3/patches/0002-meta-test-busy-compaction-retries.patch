+// These test-only exports let the external-package object test exercise the
+// ordinary entry and observe raw metadata without issuing additional user IO.
+// They also compile on the unmodified release.
+func RunNativeCompactForTest(m Meta, inode Ino) {
+	m.getBase().compactChunk(inode, 0, false, false, 0)
+}
+
+func NativeCompactIdleForTest(m Meta) bool {
+	b := m.getBase()
+	b.Lock()
+	defer b.Unlock()
+	return len(b.compacting) == 0
+}
+
+func NativeCompactHistoryForTest(m Meta, inode Ino) ([]Slice, syscall.Errno) {
+	raw, st := m.getBase().en.doRead(Background(), inode, 0)
+	var result []Slice
+	for _, s := range raw {
+		result = append(result, Slice{Id: s.id, Size: s.size, Off: s.off, Len: s.len})
+	}
+	return result, st
+}
+
+type compactRetryGate struct {
+	ch   chan struct{}
+	once sync.Once
+}
+
+func (g *compactRetryGate) release() { g.once.Do(func() { close(g.ch) }) }
+
+type compactRetryEvent struct {
+	inode Ino
+	call  int
+}
+
+type compactRetryEngine struct {
+	engine
+	f *compactRetryFixture
+}
+
+func (e *compactRetryEngine) doRead(ctx Context, inode Ino, index uint32) ([]*slice, syscall.Errno) {
+	e.f.mu.Lock()
+	e.f.reads[inode]++
+	n := e.f.reads[inode]
+	hook := e.f.afterRead
+	e.f.mu.Unlock()
+	ss, st := e.engine.doRead(ctx, inode, index)
+	if hook != nil {
+		hook(inode, n)
+	}
+	return ss, st
+}
+
+type compactRetryFixture struct {
+	client    Meta
+	m         *baseMeta
+	original  engine
+	mu        sync.Mutex
+	owners    map[uint64]Ino
+	reads     map[Ino]int
+	calls     map[Ino]int
+	holds     map[compactRetryEvent]*compactRetryGate
+	fail      map[Ino]bool
+	gates     []*compactRetryGate
+	started   chan compactRetryEvent
+	runs      sync.WaitGroup
+	afterRead func(Ino, int)
+	active    int
+	peak      int
+}
+
+func newCompactRetryFixture(t *testing.T, backend string) *compactRetryFixture {
+	t.Helper()
+	conf := testConfig()
+	conf.NoBGJob, conf.MaxDeletes = true, 0
+	var client Meta
+	var err error
+	switch backend {
+	case "sqlite":
+		client, err = newSQLMeta("sqlite3", filepath.Join(t.TempDir(), "retry.db"), conf)
+	case "redis":
+		socket := os.Getenv("COMPACT_RETRY_REDIS_SOCKET")
+		if socket == "" {
+			t.Skip("set COMPACT_RETRY_REDIS_SOCKET to a dedicated test Redis socket")
+		}
+		client, err = newRedisMeta("unix", socket+"?db=0", conf)
+	default:
+		client, err = newKVMeta("memkv", t.Name(), conf)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Init(testFormat(), true); err != nil {
+		t.Fatal(err)
+	}
+	m := client.getBase()
+	m.sessCtx = Background()
+	f := &compactRetryFixture{client: client, m: m, original: m.en,
+		owners: make(map[uint64]Ino), reads: make(map[Ino]int), calls: make(map[Ino]int),
+		holds: make(map[compactRetryEvent]*compactRetryGate), fail: make(map[Ino]bool),
+		started: make(chan compactRetryEvent, 128)}
+	m.en = &compactRetryEngine{engine: m.en, f: f}
+	m.OnMsg(DeleteSlice, func(...interface{}) error { return nil })
+	m.OnMsg(CompactChunk, func(args ...interface{}) error {
+		ss := args[0].([]Slice)
+		f.mu.Lock()
+		inode := f.owners[ss[0].Id]
+		f.owners[args[1].(uint64)] = inode
+		f.calls[inode]++
+		event := compactRetryEvent{inode, f.calls[inode]}
+		gate, fail := f.holds[event], f.fail[inode]
+		f.active++
+		f.peak = max(f.peak, f.active)
+		f.mu.Unlock()
+		f.started <- event
+		if gate != nil {
+			<-gate.ch
+		}
+		f.mu.Lock()
+		f.active--
+		f.mu.Unlock()
+		if fail {
+			return fmt.Errorf("injected compaction failure")
+		}
+		return nil
+	})
+	t.Cleanup(func() {
+		for _, g := range f.gates {
+			g.release()
+		}
+		f.wait(t)
+		m.sessCtx.Cancel()
+		if err := client.Shutdown(); err != nil {
+			t.Error(err)
+		}
+	})
+	return f
+}
+
+func (f *compactRetryFixture) gate() *compactRetryGate {
+	g := &compactRetryGate{ch: make(chan struct{})}
+	f.gates = append(f.gates, g)
+	return g
+}
+
+func (f *compactRetryFixture) hold(inode Ino, call int) *compactRetryGate {
+	g := f.gate()
+	f.holds[compactRetryEvent{inode, call}] = g
+	return g
+}
+
+func (f *compactRetryFixture) write(t *testing.T, inode Ino, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		var id uint64
+		if st := f.m.NewSlice(Background(), &id); st != 0 {
+			t.Fatal(st)
+		}
+		f.mu.Lock()
+		f.owners[id] = inode
+		f.mu.Unlock()
+		var count int
+		var delta dirStat
+		var attr Attr
+		if st := f.original.doWrite(Background(), inode, 0, 0,
+			Slice{Id: id, Size: 64 << 10, Len: 64 << 10}, time.Now(), &count, &delta, &attr); st != 0 {
+			t.Fatal(st)
+		}
+	}
+}
+
+func (f *compactRetryFixture) file(t *testing.T, name string, n int) Ino {
+	t.Helper()
+	var inode Ino
+	if st := f.m.Create(Background(), RootInode, name, 0600, 0, 0, &inode, nil); st != 0 {
+		t.Fatal(st)
+	}
+	f.write(t, inode, n)
+	return inode
+}
+
+func (f *compactRetryFixture) run(inode Ino, force bool) <-chan struct{} {
+	done := make(chan struct{})
+	f.runs.Add(1)
+	go func() {
+		defer f.runs.Done()
+		defer close(done)
+		f.m.compactChunk(inode, 0, false, force, 0)
+	}()
+	return done
+}
+
+func (f *compactRetryFixture) next(t *testing.T) compactRetryEvent {
+	t.Helper()
+	select {
+	case event := <-f.started:
+		return event
+	case <-time.After(2 * time.Second):
+		t.Fatal("COMPACT_RETRY_MISSING: no compaction after a busy slot was released")
+		return compactRetryEvent{}
+	}
+}
+
+func (f *compactRetryFixture) wait(t *testing.T) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() { f.runs.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("compaction caller did not finish")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for !NativeCompactIdleForTest(f.client) {
+		if time.Now().After(deadline) {
+			t.Fatal("compaction slots did not drain")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func (f *compactRetryFixture) records(t *testing.T, inode Ino) int {
+	t.Helper()
+	ss, st := f.original.doRead(Background(), inode, 0)
+	if st != 0 {
+		t.Fatal(st)
+	}
+	return len(ss)
+}
+
+func TestCompactRetryGlobal(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		for _, failed := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/error-%v", backend, failed), func(t *testing.T) {
+				f := newCompactRetryFixture(t, backend)
+				var gates []*compactRetryGate
+				for i := 0; i < 11; i++ {
+					inode := f.file(t, fmt.Sprintf("blocker-%d", i), 5)
+					gates = append(gates, f.hold(inode, 1))
+					f.fail[inode] = failed && i == 0
+					f.run(inode, false)
+					if event := f.next(t); event.inode != inode {
+						t.Fatal(event)
+					}
+				}
+				victims := make(map[Ino]*compactRetryGate)
+				for i := 0; i < 2; i++ {
+					inode := f.file(t, fmt.Sprintf("victim-%d", i), 99)
+					victims[inode] = f.hold(inode, 1)
+					f.m.compactChunk(inode, 0, false, false, 0)
+					// A synchronous max-slices check that finds too little work
+					// must not consume the queued ordinary request.
+					f.m.compactChunk(inode, 0, true, false, 0)
+				}
+				gates[0].release()
+				for i := 0; i < 2; i++ {
+					event := f.next(t)
+					gate := victims[event.inode]
+					if gate == nil || event.call != 1 {
+						t.Fatalf("unexpected dispatched work: %+v", event)
+					}
+					f.m.Lock()
+					n := len(f.m.compacting)
+					f.m.Unlock()
+					if n != 11 {
+						t.Fatalf("slot transfer changed ordinary concurrency: %d", n)
+					}
+					gate.release()
+				}
+				for _, gate := range gates {
+					gate.release()
+				}
+				f.wait(t)
+				for inode := range victims {
+					if n := f.records(t, inode); n != 1 {
+						t.Fatalf("COMPACT_RETRY_MISSING: retained %d records", n)
+					}
+				}
+				if f.peak > 11 {
+					t.Fatalf("too many concurrent object callbacks: %d", f.peak)
+				}
+			})
+		}
+	}
+}
+
+func TestCompactRetrySameChunk(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := newCompactRetryFixture(t, backend)
+			inode := f.file(t, "same", 99)
+			gate := f.hold(inode, 1)
+			f.run(inode, false)
+			f.next(t)
+			f.write(t, inode, 99) // New history arrives after the first batch read.
+			for i := 0; i < 256; i++ {
+				f.m.compactChunk(inode, 0, false, false, 0)
+			}
+			gate.release()
+			f.wait(t)
+			if n := f.records(t, inode); n != 1 {
+				t.Fatalf("COMPACT_RETRY_MISSING: appended history retained %d records", n)
+			}
+			if f.reads[inode] != 2 || f.calls[inode] != 2 {
+				t.Fatalf("missed triggers were not coalesced: reads=%d callbacks=%d", f.reads[inode], f.calls[inode])
+			}
+		})
+	}
+}
+
+func TestCompactRetryNoRedundantRewrite(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := newCompactRetryFixture(t, backend)
+			inode := f.file(t, "duplicate", 5)
+			gate := f.hold(inode, 1)
+			f.run(inode, false)
+			f.next(t)
+			for i := 0; i < 256; i++ {
+				f.m.compactChunk(inode, 0, false, false, 0)
+			}
+			gate.release()
+			f.wait(t)
+			if f.records(t, inode) != 1 || f.calls[inode] != 1 || f.reads[inode] > 2 {
+				t.Fatalf("redundant work: reads=%d callbacks=%d", f.reads[inode], f.calls[inode])
+			}
+		})
+	}
+}
+
+func TestCompactRetryFailureDoesNotLoop(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := newCompactRetryFixture(t, backend)
+			inode := f.file(t, "failure", 5)
+			f.fail[inode] = true
+			f.m.compactChunk(inode, 0, false, false, 0)
+			f.wait(t)
+			if f.calls[inode] != 1 || f.reads[inode] != 1 || f.records(t, inode) != 5 {
+				t.Fatal("object failure was changed into an automatic retry loop")
+			}
+		})
+	}
+}
+
+func TestCompactRetryCancellation(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := newCompactRetryFixture(t, backend)
+			if err := f.client.NewSession(false); err != nil {
+				t.Fatal(err)
+			}
+			inode := f.file(t, "cancel", 99)
+			gate := f.hold(inode, 1)
+			f.run(inode, false)
+			f.next(t)
+			f.write(t, inode, 99)
+			f.m.compactChunk(inode, 0, false, false, 0)
+			if err := f.client.CloseSession(); err != nil {
+				t.Fatal(err)
+			}
+			gate.release()
+			f.wait(t)
+			if f.calls[inode] != 1 || f.reads[inode] != 1 {
+				t.Fatal("queued work started after session cancellation")
+			}
+		})
+	}
+}
+
+func TestCompactRetryForcedOwnership(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := newCompactRetryFixture(t, backend)
+			inode := f.file(t, "forced", maxCompactSlices+2)
+			first, second, third := f.hold(inode, 1), f.hold(inode, 2), f.hold(inode, 3)
+			readGate := f.gate()
+			readStarted := make(chan struct{})
+			f.afterRead = func(ino Ino, n int) {
+				if ino == inode && n == 3 {
+					close(readStarted)
+					<-readGate.ch
+				}
+			}
+			done := f.run(inode, true)
+			f.next(t)
+			f.m.compactChunk(inode, 0, false, false, 0)
+			first.release()
+			if event := f.next(t); event.call != 2 {
+				t.Fatal(event)
+			}
+			second.release()
+			select {
+			case <-readStarted:
+			case <-time.After(2 * time.Second):
+				t.Fatal("forced compaction did not reach its final metadata read")
+			}
+			f.write(t, inode, 99)
+			f.m.compactChunk(inode, 0, false, false, 0)
+			readGate.release()
+			select {
+			case <-done:
+			case <-time.After(2 * time.Second):
+				t.Fatal("forced compaction did not return")
+			}
+			if event := f.next(t); event.call != 3 {
+				t.Fatal(event)
+			}
+			f.m.Lock()
+			owned := f.m.compacting[uint64(inode)]
+			f.m.Unlock()
+			if !owned {
+				t.Fatal("forced recursion released a slot already transferred to a retry")
+			}
+			third.release()
+			f.wait(t)
+			if f.records(t, inode) != 1 {
+				t.Fatal("retry after forced compaction did not finish")
+			}
+		})
+	}
+}
