+// Unit tests drive the same scheduler step with a synthetic future clock.
+// Real-session/real-object tests separately exercise automatic timer startup.
+func v3Fixture(t *testing.T, backend string) *compactRetryFixture {
+	f := newCompactRetryFixture(t, backend)
+	f.m.conf.NoBGJob = false
+	f.m.conf.IdleCompactDelay = time.Second
+	return f
+}
+
+func v3Pending(m *baseMeta) int {
+	m.idleCompactMu.Lock()
+	defer m.idleCompactMu.Unlock()
+	return len(m.idleCompactStateLocked().pending)
+}
+
+func v3Write(t *testing.T, f *compactRetryFixture, inode Ino, pos uint32) {
+	t.Helper()
+	var id uint64
+	if st := f.m.NewSlice(Background(), &id); st != 0 {
+		t.Fatal(st)
+	}
+	f.mu.Lock()
+	f.owners[id] = inode
+	f.mu.Unlock()
+	if st := f.m.Write(Background(), inode, 0, pos, Slice{Id: id, Size: 64 << 10, Len: 64 << 10}, time.Now()); st != 0 {
+		t.Fatal(st)
+	}
+}
+
+func v3Overwrites(t *testing.T, f *compactRetryFixture, inode Ino, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		v3Write(t, f, inode, 0)
+	}
+}
+
+func v3Calls(f *compactRetryFixture, inode Ino) int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.calls[inode]
+}
+
+func TestIdleCompactV3LowRecords(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		for _, n := range []int{2, 5, 34, 98} {
+			t.Run(fmt.Sprintf("%s/n%d", backend, n), func(t *testing.T) {
+				f := v3Fixture(t, backend)
+				inode := f.file(t, "low", 0)
+				v3Overwrites(t, f, inode, n)
+				if f.records(t, inode) != n || v3Calls(f, inode) != 0 {
+					t.Fatal("unexpected ordinary compaction")
+				}
+				f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+				f.wait(t)
+				if f.records(t, inode) != 1 || v3Calls(f, inode) != 1 || v3Pending(f.m) != 0 {
+					t.Fatal("low history did not drain without Read/forced compact")
+				}
+				t.Logf("writes=%d raw=1 idle_batches=1 public_Read=0", n)
+			})
+		}
+	}
+}
+
+func TestIdleCompactV3PostSnapshotTail(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := v3Fixture(t, backend)
+			inode := f.file(t, "tail", 0)
+			gate := f.hold(inode, 1)
+			v3Overwrites(t, f, inode, 99)
+			f.next(t)
+			v3Overwrites(t, f, inode, 5)
+			gate.release()
+			f.wait(t)
+			if f.records(t, inode) != 6 {
+				t.Fatal("did not reproduce low-count tail")
+			}
+			f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+			f.wait(t)
+			if f.records(t, inode) != 1 || v3Calls(f, inode) != 2 || v3Pending(f.m) != 0 {
+				t.Fatal("post-snapshot tail retained")
+			}
+		})
+	}
+}
+
+func TestIdleCompactV3WriteDuringInspection(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := v3Fixture(t, backend)
+			inode := f.file(t, "generation", 0)
+			v3Overwrites(t, f, inode, 2)
+			gate := f.hold(inode, 1)
+			done := make(chan struct{})
+			go func() { defer close(done); f.m.idleCompactStep(time.Now().Add(2 * time.Second)) }()
+			f.next(t)
+			v3Overwrites(t, f, inode, 3)
+			gate.release()
+			select {
+			case <-done:
+			case <-time.After(5 * time.Second):
+				t.Fatal("idle batch did not finish")
+			}
+			if v3Pending(f.m) != 1 || f.records(t, inode) != 4 {
+				t.Fatal("new generation was discarded")
+			}
+			f.m.idleCompactStep(time.Now().Add(3 * time.Second))
+			f.wait(t)
+			if f.records(t, inode) != 1 || v3Pending(f.m) != 0 {
+				t.Fatal("new generation did not drain")
+			}
+		})
+	}
+}
+
+func TestIdleCompactV3QuietAndInFlight(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	inode := f.file(t, "quiet", 0)
+	v3Overwrites(t, f, inode, 2)
+	f.m.idleCompactStep(time.Now())
+	f.m.beginIdleCompactIO()
+	f.m.idleCompactStep(time.Now().Add(time.Hour))
+	f.m.endIdleCompactIO()
+	var live []Slice
+	if st := f.m.Read(Background(), inode, 0, &live); st != 0 {
+		t.Fatal(st)
+	}
+	f.m.idleCompactStep(time.Now().Add(500 * time.Millisecond))
+	if v3Calls(f, inode) != 0 {
+		t.Fatal("idle work ran during metadata IO/quiet delay")
+	}
+	f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+	if f.records(t, inode) != 1 {
+		t.Fatal("quiet work missing")
+	}
+}
+
+func TestIdleCompactV3NonOverlapping(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := v3Fixture(t, backend)
+			inode := f.file(t, "valid", 0)
+			v3Write(t, f, inode, 0)
+			v3Write(t, f, inode, 64<<10)
+			f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+			if f.records(t, inode) != 2 || v3Calls(f, inode) != 0 || v3Pending(f.m) != 0 {
+				t.Fatal("valid non-overlapping records were rewritten")
+			}
+		})
+	}
+}
+
+func TestIdleCompactV3FailureBackoff(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := v3Fixture(t, backend)
+			inode := f.file(t, "retry", 0)
+			v3Overwrites(t, f, inode, 3)
+			f.mu.Lock()
+			f.fail[inode] = true
+			f.mu.Unlock()
+			now := time.Now().Add(2 * time.Second)
+			f.m.idleCompactStep(now)
+			for i := 0; i < 50; i++ {
+				f.m.idleCompactStep(now.Add(time.Second))
+			}
+			if v3Calls(f, inode) != 1 || f.records(t, inode) != 3 || v3Pending(f.m) != 1 {
+				t.Fatal("failure spun or tracking was lost")
+			}
+			f.mu.Lock()
+			f.fail[inode] = false
+			f.mu.Unlock()
+			f.m.idleCompactStep(now.Add(11 * time.Second))
+			if v3Calls(f, inode) != 2 || f.records(t, inode) != 1 || v3Pending(f.m) != 0 {
+				t.Fatal("failure did not recover")
+			}
+		})
+	}
+}
+
+func TestIdleCompactV3SingleWorkerAndAdmission(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	a, b := f.file(t, "a", 0), f.file(t, "b", 0)
+	v3Overwrites(t, f, a, 2)
+	v3Overwrites(t, f, b, 2)
+	f.m.Lock()
+	f.m.compacting[999] = true
+	f.m.Unlock()
+	now := time.Now().Add(2 * time.Second)
+	f.m.idleCompactStep(now)
+	if v3Calls(f, a)+v3Calls(f, b) != 0 {
+		t.Fatal("idle work competed with an active ordinary compactor")
+	}
+	f.m.Lock()
+	delete(f.m.compacting, 999)
+	f.m.Unlock()
+	gate := f.hold(b, 1) // a was rotated to the queue tail after admission failed
+	done := make(chan struct{})
+	go func() { defer close(done); f.m.idleCompactStep(now.Add(20 * time.Second)) }()
+	f.next(t)
+	f.m.idleCompactStep(now.Add(30 * time.Second))
+	if v3Calls(f, a) != 0 || v3Calls(f, b) != 1 {
+		t.Fatal("more than one idle worker admitted")
+	}
+	gate.release()
+	<-done
+	f.m.idleCompactStep(now.Add(40 * time.Second))
+	if f.records(t, a) != 1 || f.records(t, b) != 1 {
+		t.Fatal("FIFO did not make progress")
+	}
+}
+
+func TestIdleCompactV3BoundedQueueAndMetrics(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	f.m.idleCompactMu.Lock()
+	f.m.idleCompactStateLocked().limit = 2
+	f.m.idleCompactMu.Unlock()
+	for i := 0; i < 3; i++ {
+		inode := f.file(t, fmt.Sprintf("limit%d", i), 0)
+		v3Overwrites(t, f, inode, 2)
+	}
+	f.m.idleCompactMu.Lock()
+	s := f.m.idleCompact
+	pending, overflow := len(s.pending), s.overflow
+	f.m.idleCompactMu.Unlock()
+	if pending != 2 || overflow != 1 {
+		t.Fatal("queue was unbounded or overflow was silent")
+	}
+	reg := prometheus.NewRegistry()
+	f.m.initIdleCompactMetrics(reg)
+	metrics, err := reg.Gather()
+	if err != nil || len(metrics) != 4 {
+		t.Fatalf("metrics: %v count=%d", err, len(metrics))
+	}
+	for _, metric := range metrics {
+		if metric.GetName() == "idle_compact_queue_overflow_total" && metric.Metric[0].Counter.GetValue() != 1 {
+			t.Fatal("overflow metric missing")
+		}
+	}
+}
+
+func TestIdleCompactV3DisabledAndCancelled(t *testing.T) {
+	for _, mode := range []string{"default", "no-bgjob", "readonly", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			f := v3Fixture(t, "memkv")
+			if mode == "default" {
+				f.m.conf.IdleCompactDelay = 0
+			} else if mode == "no-bgjob" {
+				f.m.conf.NoBGJob = true
+			}
+			inode := f.file(t, "disabled", 0)
+			v3Overwrites(t, f, inode, 2)
+			if mode == "readonly" {
+				f.m.conf.ReadOnly = true
+			}
+			if mode == "cancel" {
+				f.m.sessCtx.Cancel()
+			}
+			f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+			if v3Calls(f, inode) != 0 || f.records(t, inode) != 2 {
+				t.Fatal("disabled/cancelled idle work ran")
+			}
+		})
+	}
+}
+
+type v3ReadFault struct {
+	engine
+	err syscall.Errno
+}
+
+func (e *v3ReadFault) doRead(Context, Ino, uint32) ([]*slice, syscall.Errno) { return nil, e.err }
+
+func TestIdleCompactV3MetadataFailure(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	inode := f.file(t, "meta-error", 0)
+	v3Overwrites(t, f, inode, 2)
+	actual := f.m.en
+	fault := &v3ReadFault{actual, syscall.EIO}
+	f.m.en = fault
+	now := time.Now().Add(2 * time.Second)
+	f.m.idleCompactStep(now)
+	if v3Pending(f.m) != 1 {
+		t.Fatal("metadata error discarded history")
+	}
+	fault.err = syscall.ENOENT
+	f.m.idleCompactStep(now.Add(11 * time.Second))
+	if v3Pending(f.m) != 0 {
+		t.Fatal("deleted inode retained forever")
+	}
+	f.m.en = actual
+}
+
+func TestIdleCompactV3ManyWriters(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	inode := f.file(t, "writers", 0)
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 10; j++ {
+				v3Write(t, f, inode, 0)
+			}
+		}()
+	}
+	wg.Wait()
+	f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+	if f.records(t, inode) != 1 || v3Pending(f.m) != 0 {
+		t.Fatal("concurrent tracking lost work")
+	}
+}
+
+func TestIdleCompactV3IOResumesDuringMetadataCheck(t *testing.T) {
+	f := v3Fixture(t, "memkv")
+	inode := f.file(t, "resume", 0)
+	v3Overwrites(t, f, inode, 2)
+	var once sync.Once
+	f.afterRead = func(Ino, int) { once.Do(func() { v3Write(t, f, inode, 0) }) }
+	f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+	if v3Calls(f, inode) != 0 || v3Pending(f.m) != 1 {
+		t.Fatal("idle compaction began despite foreground IO resuming during inspection")
+	}
+	f.afterRead = nil
+	f.m.idleCompactStep(time.Now().Add(2 * time.Second))
+	if f.records(t, inode) != 1 || v3Pending(f.m) != 0 {
+		t.Fatal("resumed IO was not retained")
+	}
+}
