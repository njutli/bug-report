+
+func TestIdleCompactDelayFlag(t *testing.T) {
+	for _, tc := range []struct {
+		name, arg string
+		delay     time.Duration
+		bad       bool
+	}{
+		{"default", "", 0, false},
+		{"enabled", "2m", 2 * time.Minute, false},
+		{"minimum", "10ms", time.Second, false},
+		{"negative", "-1s", 0, false},
+		{"invalid", "not-a-duration", 0, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := cmdMount()
+			called := false
+			cmd.Action = func(c *cli.Context) error {
+				called = true
+				conf := getMetaConf(c, "/not-mounted", false)
+				conf.SelfCheck()
+				if conf.IdleCompactDelay != tc.delay {
+					t.Fatalf("delay=%s want=%s", conf.IdleCompactDelay, tc.delay)
+				}
+				return nil // Never invokes mount or opens a metadata URL.
+			}
+			app := cli.NewApp()
+			app.Writer, app.ErrWriter = io.Discard, io.Discard
+			app.Commands = []*cli.Command{cmd}
+			args := []string{"juicefs", "mount"}
+			if tc.arg != "" {
+				args = append(args, "--idle-compact-delay="+tc.arg)
+			}
+			args = append(args, "unused-meta-url", "/not-mounted")
+			err := app.Run(args)
+			if tc.bad {
+				if err == nil || called {
+					t.Fatal("invalid flag was accepted")
+				}
+			} else if err != nil || !called {
+				t.Fatalf("flag parse/action failed: %v", err)
+			}
+		})
+	}
