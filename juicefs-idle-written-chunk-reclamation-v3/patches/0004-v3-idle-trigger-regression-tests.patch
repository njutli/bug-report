+	"github.com/juicedata/juicefs/pkg/vfs"
+)
+
+// Automatic session timer, real CachedStore/vfs.Compact, actual memory objects
+// and source deletion. No public Meta.Read/forced compaction before freeze.
+func TestIdleCompactV3AutomaticRealObjects(t *testing.T) {
+	for _, tail := range []bool{false, true} {
+		t.Run(fmt.Sprintf("concurrent-tail-%v", tail), func(t *testing.T) { testIdleCompactV3Objects(t, tail) })
+	}
+}
+
+func testIdleCompactV3Objects(t *testing.T, tail bool) {
+	blob, err := object.CreateStorage("mem", t.Name(), "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	conf := meta.DefaultConf()
+	conf.IdleCompactDelay = time.Second
+	m := meta.NewClient("sqlite3://"+filepath.Join(t.TempDir(), "objects.db"), conf)
+	if err = m.Init(&meta.Format{Name: "idle-v3", UUID: "idle-v3", Storage: "mem", BlockSize: 64, Compression: "none"}, true); err != nil {
+		t.Fatal(err)
+	}
+	cconf := chunk.Config{BlockSize: 64 << 10, Compress: "none", MaxUpload: 2, MaxDownload: 2,
+		BufferSize: 8 << 20, CacheDir: "memory", GetTimeout: time.Second, PutTimeout: time.Second}
+	store := chunk.NewCachedStore(blob, cconf, nil)
+	var mu sync.Mutex
+	var outputs []uint64
+	started, release := make(chan struct{}), make(chan struct{})
+	var releaseOnce sync.Once
+	unblock := func() { releaseOnce.Do(func() { close(release) }) }
+	m.OnMsg(meta.CompactChunk, func(args ...interface{}) error {
+		mu.Lock()
+		outputs = append(outputs, args[1].(uint64))
+		first := len(outputs) == 1
+		mu.Unlock()
+		if tail && first {
+			close(started)
+			<-release
+		}
+		return vfs.Compact(cconf, store, args[0].([]meta.Slice), args[1].(uint64), args[2].(uint8))
+	})
+	m.OnMsg(meta.DeleteSlice, func(args ...interface{}) error { return store.Remove(args[0].(uint64), int(args[1].(uint32))) })
+	if err = m.NewSession(true); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { unblock(); _ = m.CloseSession(); _ = m.Shutdown() })
+	var inode meta.Ino
+	if st := m.Create(meta.Background(), meta.RootInode, "data", 0600, 0, 0, &inode, nil); st != 0 {
+		t.Fatal(st)
+	}
+	type source struct {
+		id   uint64
+		size int
+	}
+	var old []source
+	expected := make([]byte, 96<<10)
+	write := func(pos, size int, value byte) {
+		var id uint64
+		if st := m.NewSlice(meta.Background(), &id); st != 0 {
+			t.Fatal(st)
+		}
+		data := bytes.Repeat([]byte{value}, size)
+		w := store.NewWriter(id, 0)
+		if n, err := w.WriteAt(data, 0); err != nil || n != size {
+			t.Fatalf("object write: %d %v", n, err)
+		}
+		if err := w.Finish(size); err != nil {
+			t.Fatal(err)
+		}
+		if st := m.Write(meta.Background(), inode, 0, uint32(pos), meta.Slice{Id: id, Size: uint32(size), Len: uint32(size)}, time.Now()); st != 0 {
+			t.Fatal(st)
+		}
+		old = append(old, source{id, size})
+		copy(expected[pos:pos+size], data)
+	}
+	write(0, 96<<10, 11)
+	write(16<<10, 32<<10, 29)
+	write(80<<10, 16<<10, 37)
+	if tail {
+		select {
+		case <-started:
+		case <-time.After(5 * time.Second):
+			t.Fatal("first automatic batch did not start")
+		}
+		write(48<<10, 16<<10, 43) // Below the ordinary trigger, after the snapshot.
+		unblock()
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		raw, errno := meta.NativeCompactHistoryForTest(m, inode)
+		if errno != 0 {
+			t.Fatal(errno)
+		}
+		if len(raw) == 1 && meta.NativeCompactIdleForTest(m) {
+			mu.Lock()
+			count := len(outputs)
+			mu.Unlock()
+			if !tail || count >= 2 {
+				break
+			}
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("automatic idle timer did not reclaim raw=%d", len(raw))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	// Freeze automatic metadata result before the first content read.
+	raw, errno := meta.NativeCompactHistoryForTest(m, inode)
+	if errno != 0 || len(raw) != 1 || raw[0].Size != uint32(len(expected)) {
+		t.Fatal("invalid final metadata")
+	}
+	mu.Lock()
+	ids := append([]uint64(nil), outputs...)
+	mu.Unlock()
+	if tail {
+		old = append(old, source{ids[0], len(expected)})
+	}
+	page := chunk.NewPage(make([]byte, len(expected)))
+	defer page.Release()
+	n, err := store.NewReader(raw[0].Id, int(raw[0].Size)).ReadAt(context.Background(), page, int(raw[0].Off))
+	if err != nil || n != len(expected) || !bytes.Equal(page.Data, expected) || crc32.ChecksumIEEE(page.Data) != crc32.ChecksumIEEE(expected) {
+		t.Fatalf("contents/CRC changed: %d %v", n, err)
+	}
+	for {
+		left := 0
+		for _, s := range old {
+			for off := 0; off < s.size; off += cconf.BlockSize {
+				key := fmt.Sprintf("chunks/%d/%d/%d_%d_%d", s.id/1000000, s.id/1000, s.id, off/cconf.BlockSize, min(cconf.BlockSize, s.size-off))
+				if _, err := blob.Head(context.Background(), key); err == nil {
+					left++
+				}
+			}
+		}
+		if left == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("old objects retained=%d", left)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	want := 1
+	if tail {
+		want = 2
+	}
+	if len(ids) != want {
+		t.Fatalf("unexpected batches=%d", len(ids))
+	}
+	t.Logf("automatic_timer=PASS raw=1 bytes=%d CRC=PASS old_objects_deleted=PASS", len(expected))
+}
