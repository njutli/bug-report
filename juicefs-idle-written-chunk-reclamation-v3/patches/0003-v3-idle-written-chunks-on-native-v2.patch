+
+package meta
+
+import (
+	"container/list"
+	"syscall"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+const idleCompactQueueLimit = 65536
+
+type idleCompactKey struct {
+	inode Ino
+	index uint32
+}
+
+type idleCompactEntry struct {
+	key        idleCompactKey
+	generation uint64
+	ready      time.Time
+	failures   uint8
+	element    *list.Element // nil while this entry is being inspected
+}
+
+type idleCompactState struct {
+	pending       map[idleCompactKey]*idleCompactEntry
+	queue         list.List
+	lastIO        time.Time
+	activeIO      int
+	busy          bool
+	workerStarted bool
+	limit         int
+	overflow      uint64
+	checks        uint64
+	attempts      uint64
+	lastWarning   time.Time
+}
+
+func (m *baseMeta) idleCompactEnabled() bool {
+	return m.conf.IdleCompactDelay > 0 && !m.conf.NoBGJob && !m.conf.ReadOnly
+}
+
+// Called with idleCompactMu held. Entries are process-local, not crash recovery.
+func (m *baseMeta) idleCompactStateLocked() *idleCompactState {
+	if m.idleCompact == nil {
+		m.idleCompact = &idleCompactState{pending: make(map[idleCompactKey]*idleCompactEntry), limit: idleCompactQueueLimit}
+	}
+	return m.idleCompact
+}
+
+func (m *baseMeta) beginIdleCompactIO() {
+	m.idleCompactMu.Lock()
+	s := m.idleCompactStateLocked()
+	s.activeIO++
+	s.lastIO = time.Now()
+	m.idleCompactMu.Unlock()
+}
+
+func (m *baseMeta) endIdleCompactIO() {
+	m.idleCompactMu.Lock()
+	s := m.idleCompactStateLocked()
+	s.activeIO--
+	s.lastIO = time.Now()
+	m.idleCompactMu.Unlock()
+}
+
+func (m *baseMeta) noteIdleCompactWrite(inode Ino, index uint32, records int) {
+	if !m.idleCompactEnabled() || (m.sessCtx != nil && m.sessCtx.Canceled()) {
+		return
+	}
+	key := idleCompactKey{inode, index}
+	m.idleCompactMu.Lock()
+	s := m.idleCompactStateLocked()
+	if e := s.pending[key]; e != nil {
+		// A write during inspection must survive completion of the old generation.
+		e.generation++
+		e.ready = time.Time{}
+		e.failures = 0
+	} else if records > 1 {
+		if len(s.pending) >= s.limit {
+			s.overflow++
+			warn := time.Since(s.lastWarning) >= time.Minute
+			if warn {
+				s.lastWarning = time.Now()
+			}
+			m.idleCompactMu.Unlock()
+			if warn {
+				logger.Warnf("idle compaction tracking is full (%d chunks); some history is NOT tracked; check idle_compact_queue_overflow_total or use controlled maintenance", idleCompactQueueLimit)
+			}
+			return
+		}
+		e := &idleCompactEntry{key: key, generation: 1}
+		e.element = s.queue.PushBack(e)
+		s.pending[key] = e
+	}
+	m.idleCompactMu.Unlock()
+}
+
+func (m *baseMeta) clearIdleCompact() {
+	m.idleCompactMu.Lock()
+	if s := m.idleCompact; s != nil {
+		clear(s.pending)
+		s.queue.Init()
+	}
+	m.idleCompactMu.Unlock()
+}
+
+func (m *baseMeta) startIdleCompact(ctx Context) {
+	if !m.idleCompactEnabled() {
+		return
+	}
+	m.idleCompactMu.Lock()
+	s := m.idleCompactStateLocked()
+	if s.workerStarted {
+		m.idleCompactMu.Unlock()
+		return
+	}
+	s.workerStarted = true
+	m.sessWG.Add(1)
+	m.idleCompactMu.Unlock()
+	go func() {
+		defer m.sessWG.Done()
+		defer func() {
+			m.clearIdleCompact()
+			m.idleCompactMu.Lock()
+			m.idleCompact.workerStarted = false
+			m.idleCompactMu.Unlock()
+		}()
+		period := min(time.Second, max(10*time.Millisecond, m.conf.IdleCompactDelay/2))
+		ticker := time.NewTicker(period)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-ticker.C:
+				// Synchronous: at most one new idle batch per client and tick.
+				m.idleCompactStep(time.Now())
+			}
+		}
+	}()
+}
+
+// Data-byte overlap, not merely several valid non-overlapping records.
+// Reuse buildSlice's latest-wins semantics; reference/deletion stays in the engine.
+func idleCompactHasHistory(ss []*slice) bool {
+	var raw, live uint64
+	for _, s := range ss {
+		if s.id != 0 {
+			raw += uint64(s.len)
+		}
+	}
+	for _, s := range buildSlice(ss) {
+		if s.Id != 0 {
+			live += uint64(s.Len)
+		}
+	}
+	return raw > live
+}
+
+// The timestamp parameter allows deterministic scheduling tests without waits.
+func (m *baseMeta) idleCompactStep(now time.Time) {
+	if !m.idleCompactEnabled() || m.sessCtx == nil || m.sessCtx.Canceled() {
+		return
+	}
+	m.idleCompactMu.Lock()
+	s := m.idleCompactStateLocked()
+	if s.busy || s.activeIO != 0 || now.Sub(s.lastIO) < m.conf.IdleCompactDelay {
+		m.idleCompactMu.Unlock()
+		return
+	}
+	var e *idleCompactEntry
+	for el := s.queue.Front(); el != nil; el = el.Next() {
+		if candidate := el.Value.(*idleCompactEntry); !now.Before(candidate.ready) {
+			e = candidate
+			break
+		}
+	}
+	if e == nil {
+		m.idleCompactMu.Unlock()
+		return
+	}
+	s.queue.Remove(e.element)
+	e.element = nil
+	s.busy = true
+	generation := e.generation
+	lastIO := s.lastIO
+	s.checks++
+	m.idleCompactMu.Unlock()
+
+	remaining, failed := true, false
+	defer func() {
+		m.idleCompactMu.Lock()
+		defer m.idleCompactMu.Unlock()
+		s.busy = false
+		if m.sessCtx.Canceled() {
+			clear(s.pending)
+			s.queue.Init()
+			return
+		}
+		if e.generation != generation {
+			// noteIdleCompactWrite updated the entry while the old snapshot ran.
+			e.ready = time.Time{}
+			e.failures = 0
+		} else if !remaining {
+			delete(s.pending, e.key)
+			return
+		} else {
+			if failed {
+				e.failures = min(e.failures+1, 6)
+			} else {
+				e.failures = 0
+			}
+			// No immediate retry chain; even no-progress/failure has a cooldown.
+			e.ready = now.Add(min(5*time.Minute, 5*time.Second*time.Duration(1<<e.failures)))
+		}
+		e.element = s.queue.PushBack(e) // round-robin, not repeated map-first selection
+	}()
+
+	// Reserve BEFORE reading history, so a same-chunk compactor cannot mutate
+	// the metadata snapshot during the probe. Never hold the admission mutex
+	// over metadata/object RPCs; the reservation alone provides exclusion.
+	k := uint64(e.key.inode) + (uint64(e.key.index) << 40)
+	m.Lock()
+	if m.sessCtx.Canceled() || len(m.compacting) != 0 || len(m.compactTodo) != 0 {
+		m.Unlock()
+		return
+	}
+	m.compacting[k] = true
+	m.Unlock()
+	owned := true
+	defer func() {
+		if owned {
+			m.releaseCompactSlot(k)
+		}
+	}()
+
+	ss, st := m.en.doRead(m.sessCtx, e.key.inode, e.key.index)
+	if st != 0 {
+		remaining, failed = st != syscall.ENOENT, st != syscall.ENOENT
+		return
+	}
+	if ss == nil {
+		failed = true
+		return
+	}
+	if !idleCompactHasHistory(ss) {
+		remaining = false
+		return
+	}
+
+	m.idleCompactMu.Lock()
+	if s.activeIO != 0 || !s.lastIO.Equal(lastIO) {
+		m.idleCompactMu.Unlock()
+		return // Foreground IO resumed during the metadata inspection.
+	}
+	if m.sessCtx.Canceled() {
+		m.idleCompactMu.Unlock()
+		return
+	}
+	s.attempts++
+	m.idleCompactMu.Unlock()
+	owned = false // The ordinary body now owns release, including on early error.
+	m.compactChunkAdmittedWithFinish(e.key.inode, e.key.index, false, false, -1, func() {
+		ss, st = m.en.doRead(m.sessCtx, e.key.inode, e.key.index)
+		if st == syscall.ENOENT {
+			remaining = false
+		} else if st != 0 || ss == nil {
+			failed = true
+		} else {
+			remaining = idleCompactHasHistory(ss)
+			failed = remaining // retain failures/no-progress, but never spin
+		}
+	})
+}
+
+func (m *baseMeta) initIdleCompactMetrics(reg prometheus.Registerer) {
+	if !m.idleCompactEnabled() {
+		return
+	}
+	value := func(kind string) float64 {
+		m.idleCompactMu.Lock()
+		defer m.idleCompactMu.Unlock()
+		s := m.idleCompactStateLocked()
+		switch kind {
+		case "pending":
+			return float64(len(s.pending))
+		case "overflow":
+			return float64(s.overflow)
+		case "checks":
+			return float64(s.checks)
+		default:
+			return float64(s.attempts)
+		}
+	}
+	reg.MustRegister(prometheus.NewGaugeFunc(prometheus.GaugeOpts{Name: "idle_compact_pending_chunks", Help: "Process-local tracked chunks, including current inspection."}, func() float64 { return value("pending") }))
+	for _, kind := range []string{"overflow", "checks", "attempts"} {
+		kind := kind
+		reg.MustRegister(prometheus.NewCounterFunc(prometheus.CounterOpts{Name: "idle_compact_queue_" + kind + "_total", Help: "Idle compaction " + kind + ". Overflow means coverage is incomplete."}, func() float64 { return value(kind) }))
+	}
+}
