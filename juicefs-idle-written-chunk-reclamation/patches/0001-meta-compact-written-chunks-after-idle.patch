+package meta
+
+import (
+	"syscall"
+	"time"
+)
+
+const idleWriteDelay = time.Minute
+const idleWriteLimit = 65536
+
+type idleWriteKey struct {
+	inode Ino
+	index uint32
+}
+
+type idleWrite struct {
+	ready      time.Time
+	generation uint64
+}
+
+// Protected by baseMeta's mutex. Only successful public Writes register work.
+func (m *baseMeta) noteIdleWrite(inode Ino, index uint32, records int) {
+	if m.conf.ReadOnly || m.conf.NoBGJob {
+		return
+	}
+	m.Lock()
+	defer m.Unlock()
+	if m.sessCtx == nil || m.sessCtx.Canceled() {
+		return
+	}
+	key := idleWriteKey{inode, index}
+	e := m.idleWrites[key]
+	if e == nil {
+		if records <= 1 {
+			return
+		}
+		if m.idleWrites == nil {
+			m.idleWrites = make(map[idleWriteKey]*idleWrite)
+		}
+		if len(m.idleWrites) >= idleWriteLimit {
+			if time.Since(m.idleWriteWarning) >= time.Minute {
+				m.idleWriteWarning = time.Now()
+				logger.Warnf("idle write compaction tracking full; some chunks omitted")
+			}
+			return
+		}
+		e = &idleWrite{}
+		m.idleWrites[key] = e
+	}
+	e.generation++
+	e.ready = time.Now().Add(idleWriteDelay)
+}
+
+func (m *baseMeta) compactIdleWrites(ctx Context) {
+	defer m.sessWG.Done()
+	defer func() { m.Lock(); m.idleWrites = nil; m.Unlock() }()
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			m.compactIdleWrite(ctx, time.Now())
+		}
+	}
+}
+
+// One batch per tick. Oldest ready entries go first; failures rotate by cooldown.
+func (m *baseMeta) compactIdleWrite(ctx Context, now time.Time) {
+	m.Lock()
+	if ctx.Canceled() || len(m.compacting) != 0 {
+		m.Unlock()
+		return
+	}
+	var key idleWriteKey
+	var entry *idleWrite
+	for k, e := range m.idleWrites {
+		if !e.ready.After(now) && (entry == nil || e.ready.Before(entry.ready)) {
+			key, entry = k, e
+		}
+	}
+	if entry == nil {
+		m.Unlock()
+		return
+	}
+	generation := entry.generation
+	k := uint64(key.inode) + (uint64(key.index) << 40)
+	m.compacting[k] = true
+	m.Unlock()
+	clean := false
+	defer func() {
+		m.Lock()
+		defer m.Unlock()
+		delete(m.compacting, k)
+		if ctx.Canceled() {
+			return
+		}
+		if entry.generation != generation {
+			return
+		}
+		if clean {
+			delete(m.idleWrites, key)
+		} else {
+			entry.ready = time.Now().Add(idleWriteDelay)
+		}
+	}()
+	ss, st := m.en.doRead(ctx, key.inode, key.index)
+	if st == syscall.ENOENT {
+		clean = true
+		return
+	}
+	if st != 0 || ss == nil || ctx.Canceled() {
+		return
+	}
+	if len(ss) <= maxCompactSlices {
+		var raw, live uint64
+		for _, s := range ss {
+			if s.id != 0 {
+				raw += uint64(s.len)
+			}
+		}
+		for _, s := range buildSlice(ss) {
+			if s.Id != 0 {
+				live += uint64(s.Len)
+			}
+		}
+		if raw == live {
+			clean = true
+			return
+		}
+	}
+	m.Lock()
+	changed := entry.generation != generation
+	m.Unlock()
+	if changed || ctx.Canceled() {
+		return
+	}
+	// Keep the entry until a later read confirms clean. Use the original batch
+	// planner, prefix/CAS and deletion; do not retain this snapshot across ticks.
+	m.compactChunkOnce(key.inode, key.index, false, -1, ss)
+}
