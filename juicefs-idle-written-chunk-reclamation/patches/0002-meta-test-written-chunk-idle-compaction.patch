+package meta
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// These test-only exports let the external-package object test observe
+// compaction state and raw metadata without issuing additional user IO.
+// They also compile on the unmodified release.
+func NativeCompactIdleForTest(m Meta) bool {
+	b := m.getBase()
+	b.Lock()
+	defer b.Unlock()
+	return len(b.compacting) == 0
+}
+
+func NativeCompactHistoryForTest(m Meta, inode Ino) ([]Slice, syscall.Errno) {
+	raw, st := m.getBase().en.doRead(Background(), inode, 0)
+	var result []Slice
+	for _, s := range raw {
+		result = append(result, Slice{Id: s.id, Size: s.size, Off: s.off, Len: s.len})
+	}
+	return result, st
+}
+
+type compactRetryGate struct {
+	ch   chan struct{}
+	once sync.Once
+}
+
+func (g *compactRetryGate) release() { g.once.Do(func() { close(g.ch) }) }
+
+type compactRetryEvent struct {
+	inode Ino
+	call  int
+}
+
+type compactRetryEngine struct {
+	engine
+	f *compactRetryFixture
+}
+
+func (e *compactRetryEngine) doRead(ctx Context, inode Ino, index uint32) ([]*slice, syscall.Errno) {
+	e.f.mu.Lock()
+	e.f.reads[inode]++
+	n := e.f.reads[inode]
+	hook := e.f.afterRead
+	e.f.mu.Unlock()
+	ss, st := e.engine.doRead(ctx, inode, index)
+	if hook != nil {
+		hook(inode, n)
+	}
+	return ss, st
+}
+
+type compactRetryFixture struct {
+	client    Meta
+	m         *baseMeta
+	original  engine
+	mu        sync.Mutex
+	owners    map[uint64]Ino
+	reads     map[Ino]int
+	calls     map[Ino]int
+	holds     map[compactRetryEvent]*compactRetryGate
+	fail      map[Ino]bool
+	gates     []*compactRetryGate
+	started   chan compactRetryEvent
+	runs      sync.WaitGroup
+	afterRead func(Ino, int)
+	active    int
+	peak      int
+}
+
+func newCompactRetryFixture(t *testing.T, backend string) *compactRetryFixture {
+	t.Helper()
+	conf := testConfig()
+	conf.NoBGJob, conf.MaxDeletes = true, 0
+	var client Meta
+	var err error
+	switch backend {
+	case "sqlite":
+		client, err = newSQLMeta("sqlite3", filepath.Join(t.TempDir(), "retry.db"), conf)
+	case "redis":
+		socket := os.Getenv("COMPACT_RETRY_REDIS_SOCKET")
+		if socket == "" {
+			t.Skip("set COMPACT_RETRY_REDIS_SOCKET to a dedicated test Redis socket")
+		}
+		client, err = newRedisMeta("unix", socket+"?db=0", conf)
+	default:
+		client, err = newKVMeta("memkv", t.Name(), conf)
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Init(testFormat(), true); err != nil {
+		t.Fatal(err)
+	}
+	m := client.getBase()
+	m.sessCtx = Background()
+	f := &compactRetryFixture{client: client, m: m, original: m.en,
+		owners: make(map[uint64]Ino), reads: make(map[Ino]int), calls: make(map[Ino]int),
+		holds: make(map[compactRetryEvent]*compactRetryGate), fail: make(map[Ino]bool),
+		started: make(chan compactRetryEvent, 128)}
+	m.en = &compactRetryEngine{engine: m.en, f: f}
+	m.OnMsg(DeleteSlice, func(...interface{}) error { return nil })
+	m.OnMsg(CompactChunk, func(args ...interface{}) error {
+		ss := args[0].([]Slice)
+		f.mu.Lock()
+		inode := f.owners[ss[0].Id]
+		f.owners[args[1].(uint64)] = inode
+		f.calls[inode]++
+		event := compactRetryEvent{inode, f.calls[inode]}
+		gate, fail := f.holds[event], f.fail[inode]
+		f.active++
+		f.peak = max(f.peak, f.active)
+		f.mu.Unlock()
+		f.started <- event
+		if gate != nil {
+			<-gate.ch
+		}
+		f.mu.Lock()
+		f.active--
+		f.mu.Unlock()
+		if fail {
+			return fmt.Errorf("injected compaction failure")
+		}
+		return nil
+	})
+	t.Cleanup(func() {
+		for _, g := range f.gates {
+			g.release()
+		}
+		f.wait(t)
+		m.sessCtx.Cancel()
+		if err := client.Shutdown(); err != nil {
+			t.Error(err)
+		}
+	})
+	return f
+}
+
+func (f *compactRetryFixture) gate() *compactRetryGate {
+	g := &compactRetryGate{ch: make(chan struct{})}
+	f.gates = append(f.gates, g)
+	return g
+}
+
+func (f *compactRetryFixture) hold(inode Ino, call int) *compactRetryGate {
+	g := f.gate()
+	f.holds[compactRetryEvent{inode, call}] = g
+	return g
+}
+
+func (f *compactRetryFixture) write(t *testing.T, inode Ino, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		var id uint64
+		if st := f.m.NewSlice(Background(), &id); st != 0 {
+			t.Fatal(st)
+		}
+		f.mu.Lock()
+		f.owners[id] = inode
+		f.mu.Unlock()
+		var count int
+		var delta dirStat
+		var attr Attr
+		if st := f.original.doWrite(Background(), inode, 0, 0,
+			Slice{Id: id, Size: 64 << 10, Len: 64 << 10}, time.Now(), &count, &delta, &attr); st != 0 {
+			t.Fatal(st)
+		}
+	}
+}
+
+func (f *compactRetryFixture) file(t *testing.T, name string, n int) Ino {
+	t.Helper()
+	var inode Ino
+	if st := f.m.Create(Background(), RootInode, name, 0600, 0, 0, &inode, nil); st != 0 {
+		t.Fatal(st)
+	}
+	f.write(t, inode, n)
+	return inode
+}
+
+func (f *compactRetryFixture) run(inode Ino, force bool) <-chan struct{} {
+	done := make(chan struct{})
+	f.runs.Add(1)
+	go func() {
+		defer f.runs.Done()
+		defer close(done)
+		f.m.compactChunk(inode, 0, false, force, 0)
+	}()
+	return done
+}
+
+func (f *compactRetryFixture) next(t *testing.T) compactRetryEvent {
+	t.Helper()
+	select {
+	case event := <-f.started:
+		return event
+	case <-time.After(2 * time.Second):
+		t.Fatal("COMPACT_RETRY_MISSING: no compaction after a busy slot was released")
+		return compactRetryEvent{}
+	}
+}
+
+func (f *compactRetryFixture) wait(t *testing.T) {
+	t.Helper()
+	done := make(chan struct{})
+	go func() { f.runs.Wait(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("compaction caller did not finish")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for !NativeCompactIdleForTest(f.client) {
+		if time.Now().After(deadline) {
+			t.Fatal("compaction slots did not drain")
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func (f *compactRetryFixture) records(t *testing.T, inode Ino) int {
+	t.Helper()
+	ss, st := f.original.doRead(Background(), inode, 0)
+	if st != 0 {
+		t.Fatal(st)
+	}
+	return len(ss)
+}
