+
+func idleWriteFixture(t *testing.T, backend string) *compactRetryFixture {
+	f := newCompactRetryFixture(t, backend)
+	f.m.conf.NoBGJob = false
+	return f
+}
+
+func writeIdleData(t *testing.T, f *compactRetryFixture, inode Ino, pos uint32) {
+	t.Helper()
+	var id uint64
+	if st := f.m.NewSlice(Background(), &id); st != 0 {
+		t.Fatal(st)
+	}
+	f.mu.Lock()
+	f.owners[id] = inode
+	f.mu.Unlock()
+	if st := f.m.Write(Background(), inode, 0, pos, Slice{Id: id, Size: 64 << 10, Len: 64 << 10}, time.Now()); st != 0 {
+		t.Fatal(st)
+	}
+}
+
+func idlePendingWrites(m *baseMeta) int {
+	m.Lock()
+	defer m.Unlock()
+	return len(m.idleWrites)
+}
+
+func TestIdleWriteLowHistory(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		for _, n := range []int{2, 5, 30, 98} {
+			t.Run(fmt.Sprintf("%s/%d", backend, n), func(t *testing.T) {
+				f := idleWriteFixture(t, backend)
+				ino := f.file(t, "data", 0)
+				for i := 0; i < n; i++ {
+					writeIdleData(t, f, ino, 0)
+				}
+				f.m.compactIdleWrite(f.m.sessCtx, time.Now())
+				if f.records(t, ino) != n {
+					t.Fatal("ran before write quiet period")
+				}
+				f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+				if f.records(t, ino) != 1 || idlePendingWrites(f.m) != 1 {
+					t.Fatal("low history not compacted/confirmation lost")
+				}
+				f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(3*idleWriteDelay))
+				if idlePendingWrites(f.m) != 0 {
+					t.Fatal("clean confirmation missing")
+				}
+			})
+		}
+	}
+}
+
+func TestIdleWriteConcurrentTail(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := idleWriteFixture(t, backend)
+			ino := f.file(t, "tail", 0)
+			writeIdleData(t, f, ino, 0)
+			writeIdleData(t, f, ino, 0)
+			gate := f.hold(ino, 1)
+			done := make(chan struct{})
+			go func() { defer close(done); f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay)) }()
+			f.next(t)
+			writeIdleData(t, f, ino, 0)
+			gate.release()
+			<-done
+			if f.records(t, ino) != 2 || idlePendingWrites(f.m) != 1 {
+				t.Fatal("concurrent tail lost")
+			}
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(3*idleWriteDelay))
+			if f.records(t, ino) != 1 || idlePendingWrites(f.m) != 0 {
+				t.Fatal("tail not reclaimed")
+			}
+		})
+	}
+}
+
+func TestIdleWriteDuringCleanRead(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "race", 0)
+	writeIdleData(t, f, ino, 0)
+	writeIdleData(t, f, ino, 0)
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+	var once sync.Once
+	f.afterRead = func(Ino, int) { once.Do(func() { writeIdleData(t, f, ino, 0) }) }
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(3*idleWriteDelay))
+	if idlePendingWrites(f.m) != 1 || f.records(t, ino) != 2 {
+		t.Fatal("old clean read discarded new write")
+	}
+	f.afterRead = nil
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(3*idleWriteDelay))
+	if f.records(t, ino) != 1 {
+		t.Fatal("new generation not processed")
+	}
+}
+
+func TestIdleWriteBusyAndValidData(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "valid", 0)
+	writeIdleData(t, f, ino, 0)
+	writeIdleData(t, f, ino, 64<<10)
+	f.m.Lock()
+	f.m.compacting[999] = true
+	f.m.Unlock()
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+	if idlePendingWrites(f.m) != 1 {
+		t.Fatal("busy discarded work")
+	}
+	f.m.Lock()
+	delete(f.m.compacting, 999)
+	f.m.Unlock()
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+	if f.records(t, ino) != 2 || f.calls[ino] != 0 || idlePendingWrites(f.m) != 0 {
+		t.Fatal("nonoverlap rewritten")
+	}
+}
+
+type idleWriteFault struct {
+	engine
+	readErr   syscall.Errno
+	commitErr syscall.Errno
+}
+
+func (e *idleWriteFault) doRead(ctx Context, ino Ino, idx uint32) ([]*slice, syscall.Errno) {
+	if e.readErr != 0 {
+		return nil, e.readErr
+	}
+	return e.engine.doRead(ctx, ino, idx)
+}
+func (e *idleWriteFault) doCompactChunk(ino Ino, idx uint32, origin []byte, ss []*slice, skip int, pos uint32, id uint64, size uint32, delayed []byte) syscall.Errno {
+	if e.commitErr != 0 {
+		return e.commitErr
+	}
+	return e.engine.doCompactChunk(ino, idx, origin, ss, skip, pos, id, size, delayed)
+}
+
+func TestIdleWriteFailureCooldown(t *testing.T) {
+	for _, kind := range []string{"read", "object", "commit"} {
+		t.Run(kind, func(t *testing.T) {
+			f := idleWriteFixture(t, "sqlite")
+			ino := f.file(t, "fault", 0)
+			writeIdleData(t, f, ino, 0)
+			writeIdleData(t, f, ino, 0)
+			fault := &idleWriteFault{engine: f.m.en}
+			f.m.en = fault
+			switch kind {
+			case "read":
+				fault.readErr = syscall.EIO
+			case "object":
+				f.fail[ino] = true
+			case "commit":
+				fault.commitErr = syscall.EINVAL
+			}
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+			if f.records(t, ino) != 2 || idlePendingWrites(f.m) != 1 {
+				t.Fatal("failure lost history")
+			}
+			f.m.Lock()
+			ready := f.m.idleWrites[idleWriteKey{ino, 0}].ready
+			f.m.Unlock()
+			if time.Until(ready) < idleWriteDelay-time.Second {
+				t.Fatal("cooldown did not start at completion")
+			}
+			fault.readErr = 0
+			fault.commitErr = 0
+			f.fail[ino] = false
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now())
+			if f.records(t, ino) != 2 {
+				t.Fatal("retry before cooldown")
+			}
+			f.m.compactIdleWrite(f.m.sessCtx, ready.Add(time.Second))
+			if f.records(t, ino) != 1 {
+				t.Fatal("recovery missing")
+			}
+		})
+	}
+}
+
+func TestIdleWriteCancellation(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "cancel", 0)
+	writeIdleData(t, f, ino, 0)
+	writeIdleData(t, f, ino, 0)
+	gate := f.hold(ino, 1)
+	done := make(chan struct{})
+	go func() { defer close(done); f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay)) }()
+	f.next(t)
+	f.m.sessCtx.Cancel()
+	gate.release()
+	<-done
+	f.m.Lock()
+	active := len(f.m.compacting)
+	f.m.Unlock()
+	if active != 0 {
+		t.Fatal("slot leaked")
+	}
+}
+
+func TestIdleWriteQueueLimit(t *testing.T) {
+	f := idleWriteFixture(t, "memkv")
+	for i := 0; i < idleWriteLimit+1; i++ {
+		f.m.noteIdleWrite(Ino(i+100), 0, 2)
+	}
+	if idlePendingWrites(f.m) != idleWriteLimit {
+		t.Fatal("queue cap violated")
+	}
+	f.m.noteIdleWrite(100, 0, 2)
+	f.m.Lock()
+	gen := f.m.idleWrites[idleWriteKey{100, 0}].generation
+	f.m.Unlock()
+	if gen != 2 {
+		t.Fatal("full queue failed to update tracked generation")
+	}
+	// Defensive case: an oversized table must reject new keys, while existing
+	// keys remain updatable. Normal registration cannot create this state.
+	f.m.Lock()
+	f.m.idleWrites[idleWriteKey{Ino(idleWriteLimit + 1000), 0}] = &idleWrite{}
+	f.m.Unlock()
+	f.m.noteIdleWrite(Ino(idleWriteLimit+1001), 0, 2)
+	if idlePendingWrites(f.m) != idleWriteLimit+1 {
+		t.Fatal("oversized queue accepted a new key")
+	}
+	f.m.noteIdleWrite(100, 0, 2)
+	f.m.Lock()
+	gen = f.m.idleWrites[idleWriteKey{100, 0}].generation
+	f.m.Unlock()
+	if gen != 3 {
+		t.Fatal("oversized queue failed to update tracked generation")
+	}
+}
+
+func TestIdleWriteOldestAndFailureRotation(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	a, b := f.file(t, "a", 0), f.file(t, "b", 0)
+	for _, ino := range []Ino{a, b} {
+		writeIdleData(t, f, ino, 0)
+		writeIdleData(t, f, ino, 0)
+	}
+	f.m.Lock()
+	f.m.idleWrites[idleWriteKey{a, 0}].ready = time.Now().Add(-2 * time.Second)
+	f.m.idleWrites[idleWriteKey{b, 0}].ready = time.Now().Add(-time.Second)
+	f.m.Unlock()
+	f.fail[a] = true
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now())
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now())
+	if f.calls[a] != 1 || f.calls[b] != 1 ||
+		f.records(t, a) != 2 || f.records(t, b) != 1 {
+		t.Fatal("failed history changed or ready work not processed")
+	}
+}
+
+func TestIdleWriteOrdinarySnapshotTail(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := idleWriteFixture(t, backend)
+			ino := f.file(t, "ordinary-tail", 0)
+			gate := f.hold(ino, 1)
+			for i := 0; i < 99; i++ {
+				writeIdleData(t, f, ino, 0)
+			}
+			f.next(t)
+			for i := 0; i < 5; i++ {
+				writeIdleData(t, f, ino, 0)
+			}
+			gate.release()
+			f.wait(t)
+			if f.records(t, ino) != 6 {
+				t.Fatal("did not retain expected prefix tail")
+			}
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+			if f.records(t, ino) != 1 {
+				t.Fatal("ordinary snapshot tail not reclaimed")
+			}
+		})
+	}
+}
+
+func TestIdleWriteLargePrefixProgress(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "large", 2105)
+	f.m.noteIdleWrite(ino, 0, 2105)
+	wantRecords := []int{1106, 107, 1, 1}
+	wantPending := []int{1, 1, 1, 0}
+	wantCalls := []int{1, 2, 3, 3}
+	for i := 0; i < 4; i++ {
+		f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+		records, pending, calls := f.records(t, ino), idlePendingWrites(f.m), f.calls[ino]
+		if records != wantRecords[i] || pending != wantPending[i] || calls != wantCalls[i] {
+			t.Fatalf("check %d: records=%d pending=%d calls=%d; want records=%d pending=%d calls=%d",
+				i+1, records, pending, calls, wantRecords[i], wantPending[i], wantCalls[i])
+		}
+		t.Logf("check %d: records=%d pending=%d calls=%d", i+1, records, pending, calls)
+	}
+	if f.records(t, ino) != 1 || idlePendingWrites(f.m) != 0 || f.calls[ino] != 3 {
+		t.Fatal("finite prefix batches failed to drain")
+	}
+}
+
+func TestIdleWriteWorkerCloseJoins(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "close", 0)
+	writeIdleData(t, f, ino, 0)
+	writeIdleData(t, f, ino, 0)
+	gate := f.hold(ino, 1)
+	f.m.Lock()
+	f.m.idleWrites[idleWriteKey{ino, 0}].ready = time.Now().Add(-time.Second)
+	f.m.Unlock()
+	f.m.sessWG.Add(1)
+	go f.m.compactIdleWrites(f.m.sessCtx)
+	f.next(t)
+	done := make(chan error, 1)
+	go func() { done <- f.client.CloseSession() }()
+	select {
+	case <-done:
+		t.Fatal("close did not wait for worker")
+	case <-time.After(30 * time.Millisecond):
+	}
+	gate.release()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("close hung")
+	}
+	if idlePendingWrites(f.m) != 0 {
+		t.Fatal("close did not clear tracking")
+	}
+}
+
+func TestIdleWriteSlowFailure(t *testing.T) {
+	f := idleWriteFixture(t, "sqlite")
+	ino := f.file(t, "slow", 0)
+	writeIdleData(t, f, ino, 0)
+	writeIdleData(t, f, ino, 0)
+	f.m.OnMsg(CompactChunk, func(...interface{}) error {
+		time.Sleep(200 * time.Millisecond)
+		return fmt.Errorf("slow backend failure")
+	})
+	f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+	completed := time.Now()
+	f.m.Lock()
+	ready := f.m.idleWrites[idleWriteKey{ino, 0}].ready
+	f.m.Unlock()
+	if ready.Sub(completed) < idleWriteDelay-50*time.Millisecond {
+		t.Fatal("operation elapsed time consumed retry cooldown")
+	}
+}
+
+func TestIdleWriteFiveFullVersions(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			f := idleWriteFixture(t, backend)
+			ino := f.file(t, "five-versions", 0)
+			for round := 0; round < 5; round++ {
+				for pos := uint32(0); pos < ChunkSize; pos += 16 << 20 {
+					var id uint64
+					if st := f.m.NewSlice(Background(), &id); st != 0 {
+						t.Fatal(st)
+					}
+					f.owners[id] = ino
+					if st := f.m.Write(Background(), ino, 0, pos, Slice{Id: id, Size: 16 << 20, Len: 16 << 20}, time.Now()); st != 0 {
+						t.Fatal(st)
+					}
+				}
+			}
+			if f.records(t, ino) != 20 || f.calls[ino] != 0 {
+				t.Fatal("unexpected original trigger")
+			}
+			f.m.compactIdleWrite(f.m.sessCtx, time.Now().Add(2*idleWriteDelay))
+			ss, st := f.original.doRead(Background(), ino, 0)
+			if st != 0 || len(ss) != 1 || ss[0].size != ChunkSize {
+				t.Fatal("full overwrite history not compacted")
+			}
+		})
+	}
+}
+
+func TestIdleWriteDisabled(t *testing.T) {
+	for _, mode := range []string{"readonly", "no-bgjob", "cancel"} {
+		t.Run(mode, func(t *testing.T) {
+			f := idleWriteFixture(t, "memkv")
+			switch mode {
+			case "readonly":
+				f.m.conf.ReadOnly = true
+			case "no-bgjob":
+				f.m.conf.NoBGJob = true
+			case "cancel":
+				f.m.sessCtx.Cancel()
+			}
+			f.m.noteIdleWrite(2, 0, 2)
+			if idlePendingWrites(f.m) != 0 {
+				t.Fatal("disabled tracking active")
+			}
+		})
+	}
+}
