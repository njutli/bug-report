+// Compiles on upstream unchanged. No direct compaction call or user Read before
+// freezing the observed automatic result. Uses the production timer duration.
+func TestIdleWriteAutomaticObjects(t *testing.T) {
+	blob, err := object.CreateStorage("mem", t.Name(), "", "", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	m := meta.NewClient("sqlite3://"+filepath.Join(t.TempDir(), "objects.db"), meta.DefaultConf())
+	if err = m.Init(&meta.Format{Name: "idle-write", UUID: "idle-write", Storage: "mem", BlockSize: 64, Compression: "none"}, true); err != nil {
+		t.Fatal(err)
+	}
+	conf := chunk.Config{BlockSize: 64 << 10, Compress: "none", MaxUpload: 2, MaxDownload: 2, BufferSize: 8 << 20, CacheDir: "memory", GetTimeout: time.Second, PutTimeout: time.Second}
+	store := chunk.NewCachedStore(blob, conf, nil)
+	m.OnMsg(meta.CompactChunk, func(args ...interface{}) error {
+		return vfs.Compact(conf, store, args[0].([]meta.Slice), args[1].(uint64), args[2].(uint8))
+	})
+	m.OnMsg(meta.DeleteSlice, func(args ...interface{}) error { return store.Remove(args[0].(uint64), int(args[1].(uint32))) })
+	if err = m.NewSession(true); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = m.CloseSession(); _ = m.Shutdown() })
+	var ino meta.Ino
+	if st := m.Create(meta.Background(), meta.RootInode, "data", 0600, 0, 0, &ino, nil); st != 0 {
+		t.Fatal(st)
+	}
+	expected := make([]byte, 96<<10)
+	var old []meta.Slice
+	key := func(id uint64, index, size int) string {
+		return fmt.Sprintf("chunks/%d/%d/%d_%d_%d", id/1000000, id/1000, id, index, size)
+	}
+	for _, w := range []struct {
+		pos, size int
+		value     byte
+	}{{0, 96 << 10, 11}, {16 << 10, 32 << 10, 29}, {80 << 10, 16 << 10, 37}} {
+		var id uint64
+		if st := m.NewSlice(meta.Background(), &id); st != 0 {
+			t.Fatal(st)
+		}
+		data := bytes.Repeat([]byte{w.value}, w.size)
+		writer := store.NewWriter(id, 0)
+		if n, e := writer.WriteAt(data, 0); e != nil || n != len(data) {
+			t.Fatalf("write %d %v", n, e)
+		}
+		if e := writer.Finish(w.size); e != nil {
+			t.Fatal(e)
+		}
+		for off := 0; off < w.size; off += conf.BlockSize {
+			if _, e := blob.Head(context.Background(), key(id, off/conf.BlockSize, min(conf.BlockSize, w.size-off))); e != nil {
+				t.Fatal(e)
+			}
+		}
+		if st := m.Write(meta.Background(), ino, 0, uint32(w.pos), meta.Slice{Id: id, Size: uint32(w.size), Len: uint32(w.size)}, time.Now()); st != 0 {
+			t.Fatal(st)
+		}
+		old = append(old, meta.Slice{Id: id, Size: uint32(w.size)})
+		copy(expected[w.pos:w.pos+w.size], data)
+	}
+	deadline := time.Now().Add(75 * time.Second)
+	var final meta.Slice
+	for {
+		raw, st := meta.NativeCompactHistoryForTest(m, ino)
+		if st != 0 {
+			t.Fatal(st)
+		}
+		if len(raw) == 1 && meta.NativeCompactIdleForTest(m) {
+			final = raw[0]
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("IDLE_WRITE_TRIGGER_MISSING records=%d", len(raw))
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	page := chunk.NewPage(make([]byte, len(expected)))
+	defer page.Release()
+	n, e := store.NewReader(final.Id, int(final.Size)).ReadAt(context.Background(), page, int(final.Off))
+	if e != nil || n != len(expected) || !bytes.Equal(page.Data, expected) || crc32.ChecksumIEEE(page.Data) != crc32.ChecksumIEEE(expected) {
+		t.Fatal("content/CRC mismatch", n, e)
+	}
+	for {
+		left := 0
+		for _, s := range old {
+			for off := 0; off < int(s.Size); off += conf.BlockSize {
+				if _, e := blob.Head(context.Background(), key(s.Id, off/conf.BlockSize, min(conf.BlockSize, int(s.Size)-off))); e == nil {
+					left++
+				}
+			}
+		}
+		if left == 0 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("old objects retained", left)
+		}
+		time.Sleep(20 * time.Millisecond)
+	}
+	t.Log("automatic_timer=PASS bytes=98304 CRC=PASS source_objects_deleted=PASS")
+}
