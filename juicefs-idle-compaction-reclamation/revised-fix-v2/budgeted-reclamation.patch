+type reclaimRedisCursor struct {
+	nodes   []*redis.Client
+	node    int
+	cursor  uint64
+	pending []string
+}
+
+func (m *redisMeta) scanReclaimPage(ctx Context, cursor interface{}, limit int) (reclaimPage, error) {
+	var page reclaimPage
+	var state reclaimRedisCursor
+	if cursor != nil {
+		state = *cursor.(*reclaimRedisCursor)
+	} else {
+		switch client := m.rdb.(type) {
+		case *redis.Client:
+			state.nodes = []*redis.Client{client}
+		case *redis.ClusterClient:
+			var mu sync.Mutex
+			err := client.ForEachMaster(ctx, func(_ context.Context, node *redis.Client) error {
+				mu.Lock()
+				state.nodes = append(state.nodes, node)
+				mu.Unlock()
+				return nil
+			})
+			if err != nil {
+				return page, err
+			}
+			sort.Slice(state.nodes, func(i, j int) bool { return state.nodes[i].Options().Addr < state.nodes[j].Options().Addr })
+		default:
+			return page, fmt.Errorf("unsupported Redis reclamation client %T", client)
+		}
+	}
+	// At most one SCAN command per page. COUNT is a Redis work hint; preserve
+	// any excess reply keys in the cursor and process at most limit LLENs.
+	if len(state.pending) == 0 && state.node < len(state.nodes) {
+		keys, next, err := state.nodes[state.node].Scan(ctx, state.cursor, m.prefix+"c*_*", int64(limit)).Result()
+		if err != nil {
+			return page, err
+		}
+		state.pending, state.cursor = keys, next
+		if next == 0 {
+			state.node++
+		}
+	}
+	n := min(limit, len(state.pending))
+	keys := state.pending[:n]
+	state.pending = state.pending[n:]
+	page.scanned = n
+	if n > 0 {
+		p := m.rdb.Pipeline()
+		for _, key := range keys {
+			p.LLen(ctx, key)
+		}
+		cmds, err := p.Exec(ctx)
+		if err != nil {
+			return page, err
+		}
+		for i, cmd := range cmds {
+			count := cmd.(*redis.IntCmd).Val()
+			if count > 1 {
+				var inode uint64
+				var index uint32
+				if n, err := fmt.Sscanf(keys[i], m.prefix+"c%d_%d", &inode, &index); err == nil && n == 2 {
+					page.chunks = append(page.chunks, cchunk{Ino(inode), index, int(count)})
+				}
+			}
+		}
+	}
+	if len(state.pending) > 0 || state.node < len(state.nodes) {
+		page.next = &state
+	}
+	return page, nil
+}
