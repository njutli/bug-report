+func (v *reclaimVolume) start(t *testing.T) {
+	t.Helper()
+	if err := v.m.NewSession(true); err != nil {
+		t.Fatal(err)
+	}
+	v.started = true
+}
+
+func (v *reclaimVolume) close(t *testing.T) {
+	t.Helper()
+	if v.started {
+		if err := v.m.CloseSession(); err != nil {
+			t.Error(err)
+		}
+		v.started = false
+	}
+	if err := v.m.Shutdown(); err != nil {
+		t.Error(err)
+	}
+}
+
+func reclaimObjectWrite(t *testing.T, v *reclaimVolume, ino meta.Ino, pos uint32, data []byte) uint64 {
+	t.Helper()
+	var id uint64
+	if st := v.m.NewSlice(meta.Background(), &id); st != 0 {
+		t.Fatal(st)
+	}
+	w := v.store.NewWriter(id, 0)
+	if n, err := w.WriteAt(data, 0); err != nil || n != len(data) {
+		t.Fatalf("write object: n=%d err=%v", n, err)
+	}
+	if err := w.Finish(len(data)); err != nil {
+		t.Fatal(err)
+	}
+	if st := v.m.Write(meta.Background(), ino, 0, pos, meta.Slice{Id: id, Size: uint32(len(data)), Len: uint32(len(data))}, time.Now()); st != 0 {
+		t.Fatal(st)
+	}
+	return id
+}
+
+func reclaimObjectFile(t *testing.T, v *reclaimVolume, name string) meta.Ino {
+	t.Helper()
+	var ino meta.Ino
+	if st := v.m.Create(meta.Background(), meta.RootInode, name, 0600, 0, 0, &ino, nil); st != 0 {
+		t.Fatal(st)
+	}
+	return ino
+}
+
+func reclaimObjectHistory(t *testing.T, v *reclaimVolume) (meta.Ino, []uint64, []byte) {
+	t.Helper()
+	ino := reclaimObjectFile(t, v, "high-gain")
+	var ids []uint64
+	for i, pos := range []uint32{0, 0, 32 << 10} {
+		ids = append(ids, reclaimObjectWrite(t, v, ino, pos, bytes.Repeat([]byte{byte(17 + i)}, 64<<10)))
+	}
+	expected := append(bytes.Repeat([]byte{18}, 32<<10), bytes.Repeat([]byte{19}, 64<<10)...)
+	return ino, ids, expected
+}
+
+func reclaimObjectKey(id uint64) string {
+	return fmt.Sprintf("chunks/%d/%d/%d_0_65536", id/1000000, id/1000, id)
+}
+
+func waitReclaimedContent(t *testing.T, v *reclaimVolume, blob object.ObjectStorage, ino meta.Ino, ids []uint64, expected []byte) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for time.Now().Before(deadline) {
+		var ss []meta.Slice
+		// Only 3 raw records/2 visible records in the fixture, below the
+		// ordinary read trigger. Polling does not substitute for reclamation.
+		if st := v.m.Read(meta.Background(), ino, 0, &ss); st != 0 {
+			t.Fatal(st)
+		}
+		if len(ss) == 1 {
+			gone := true
+			for _, id := range ids {
+				if _, err := blob.Head(context.Background(), reclaimObjectKey(id)); err == nil {
+					gone = false
+				}
+			}
+			if gone {
+				page := chunk.NewPage(make([]byte, ss[0].Len))
+				n, err := v.store.NewReader(ss[0].Id, int(ss[0].Size)).ReadAt(context.Background(), page, int(ss[0].Off))
+				ok := err == nil && n == len(expected) && bytes.Equal(page.Data, expected) && crc32.ChecksumIEEE(page.Data) == crc32.ChecksumIEEE(expected)
+				page.Release()
+				if !ok {
+					t.Fatalf("content/CRC mismatch n=%d err=%v", n, err)
+				}
+				return
+			}
+		}
+		time.Sleep(25 * time.Millisecond)
+	}
+	t.Fatal("timed out waiting for stable-history reclamation")
+}
+
+func TestReclaimRealObjects(t *testing.T) {
+	for _, restart := range []bool{false, true} {
+		t.Run(fmt.Sprintf("restart-%v", restart), func(t *testing.T) {
+			storage, err := object.CreateStorage("mem", t.Name(), "", "", "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			blob := &reclaimObjectCounter{ObjectStorage: storage}
+			uri := "sqlite3://" + filepath.Join(t.TempDir(), "meta.db")
+			v := reclaimVolumeForTest(t, uri, true, !restart, blob)
+			ino, ids, expected := reclaimObjectHistory(t, v)
+			before := blob.bytes.Load()
+			if restart {
+				v.start(t)
+				v.close(t)
+				v = reclaimVolumeForTest(t, uri, false, true, blob)
+			}
+			defer v.close(t)
+			v.start(t)
+			waitReclaimedContent(t, v, blob, ino, ids, expected)
+			if v.calls.Load() != 1 || blob.bytes.Load()-before != 96<<10 || blob.deletes.Load() != 3 {
+				t.Fatalf("unexpected object work: calls=%d bytes=%d deletes=%d", v.calls.Load(), blob.bytes.Load()-before, blob.deletes.Load())
+			}
+			t.Logf("CRC=PASS old_objects_deleted=%d actual_compaction_PUT_bytes=%d", blob.deletes.Load(), blob.bytes.Load()-before)
+		})
+	}
+}
+
+func TestReclaimRealObjectNegativeControls(t *testing.T) {
+	for _, scenario := range []string{"small-overwrites", "no-garbage", "internal-hole"} {
+		t.Run(scenario, func(t *testing.T) {
+			storage, err := object.CreateStorage("mem", t.Name(), "", "", "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			blob := &reclaimObjectCounter{ObjectStorage: storage}
+			v := reclaimVolumeForTest(t, "sqlite3://"+filepath.Join(t.TempDir(), "meta.db"), true, true, blob)
+			defer v.close(t)
+			victim := reclaimObjectFile(t, v, "negative")
+			data := bytes.Repeat([]byte{0xA5}, 256<<10)
+			if scenario == "small-overwrites" {
+				reclaimObjectWrite(t, v, victim, 0, bytes.Repeat([]byte{0x13}, meta.ChunkSize))
+				for i := 0; i < 3; i++ {
+					reclaimObjectWrite(t, v, victim, meta.ChunkSize/2, data)
+				}
+			} else {
+				reclaimObjectWrite(t, v, victim, 0, data)
+				pos := uint32(len(data))
+				if scenario == "internal-hole" {
+					pos = meta.ChunkSize - uint32(len(data))
+				}
+				reclaimObjectWrite(t, v, victim, pos, data)
+			}
+			// A high-gain sentinel proves the worker actually ran two stages;
+			// zero victim rewrites cannot be explained by a disabled scheduler.
+			ino, ids, expected := reclaimObjectHistory(t, v)
+			before := blob.bytes.Load()
+			v.start(t)
+			waitReclaimedContent(t, v, blob, ino, ids, expected)
+			time.Sleep(1100 * time.Millisecond)
+			if v.calls.Load() != 1 || blob.bytes.Load()-before != 96<<10 {
+				t.Fatalf("negative target rewritten: calls=%d added_PUT=%d", v.calls.Load(), blob.bytes.Load()-before)
+			}
+			t.Logf("victim_rewrites=0 sentinel_rewrites=1 actual_added_PUT_bytes=%d", blob.bytes.Load()-before)
+		})
+	}
+}
