+type reclaimVolume struct {
+	m       meta.Meta
+	store   chunk.ChunkStore
+	calls   atomic.Int64
+	started bool
+}
+
+func reclaimVolumeForTest(t *testing.T, uri string, initialize, enabled bool, blob object.ObjectStorage) *reclaimVolume {
+	t.Helper()
+	conf := meta.DefaultConf()
+	conf.MountPoint = t.TempDir()
+	if enabled {
+		c := meta.DefaultReclaimConfig()
+		c.Interval, c.MinAge = time.Second, 20*time.Millisecond
+		conf.Reclaim = &c
+	}
+	m := meta.NewClient(uri, conf)
+	if initialize {
+		format := &meta.Format{Name: "reclaim-integration", UUID: fmt.Sprintf("reclaim-%d", time.Now().UnixNano()), Storage: "mem", BlockSize: 64, Compression: "none", TrashDays: 0}
+		if err := m.Init(format, true); err != nil {
+			t.Fatal(err)
+		}
+	} else if _, err := m.Load(true); err != nil {
+		t.Fatal(err)
+	}
+	cconf := chunk.Config{BlockSize: 64 << 10, Compress: "none", MaxUpload: 2, MaxDownload: 2, BufferSize: 8 << 20, CacheDir: "memory", GetTimeout: time.Second, PutTimeout: time.Second}
+	store := chunk.NewCachedStore(blob, cconf, nil)
+	v := &reclaimVolume{m: m, store: store}
+	m.OnMsg(meta.CompactChunk, func(args ...interface{}) error {
+		v.calls.Add(1)
+		return Compact(cconf, store, args[0].([]meta.Slice), args[1].(uint64), args[2].(uint8))
+	})
+	m.OnMsg(meta.DeleteSlice, func(args ...interface{}) error { return store.Remove(args[0].(uint64), int(args[1].(uint32))) })
+	return v
+}
