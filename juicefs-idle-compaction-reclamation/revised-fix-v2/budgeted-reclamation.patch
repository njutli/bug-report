+package cmd
+
+import (
+	"flag"
+	"testing"
+	"time"
+
+	"github.com/urfave/cli/v2"
+)
+
+func TestReclaimMountConfig(t *testing.T) {
+	for _, enabled := range []bool{false, true} {
+		flags := flag.NewFlagSet("reclaim", flag.ContinueOnError)
+		for _, f := range metaFlags() {
+			if err := f.Apply(flags); err != nil {
+				t.Fatal(err)
+			}
+		}
+		args := []string{}
+		if enabled {
+			args = []string{"--reclaim-interval", "1m", "--reclaim-min-age", "20m", "--reclaim-scan-limit", "64", "--reclaim-max-chunks", "2", "--reclaim-max-bytes", "128M", "--reclaim-min-bytes", "1M", "--reclaim-min-gain", "50"}
+		}
+		if err := flags.Parse(args); err != nil {
+			t.Fatal(err)
+		}
+		conf := getMetaConf(cli.NewContext(cli.NewApp(), flags, nil), "/scope", false)
+		if !enabled {
+			if conf.Reclaim != nil {
+				t.Fatal("reclamation enabled by default")
+			}
+			continue
+		}
+		r := conf.Reclaim
+		if r == nil || r.Interval != time.Minute || r.MinAge != 20*time.Minute || r.ScanLimit != 64 || r.MaxChunks != 2 || r.MaxBytes != 128<<20 || r.MinBytes != 1<<20 || r.MinGain != 50 {
+			t.Fatalf("incorrect reclaim options: %+v", r)
+		}
+	}
+}
