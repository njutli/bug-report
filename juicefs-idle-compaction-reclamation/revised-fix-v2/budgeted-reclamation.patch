+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package meta
+
+import (
+	"crypto/sha256"
+	"time"
+
+	"github.com/juicedata/juicefs/pkg/utils"
+)
+
+// ReclaimConfig controls an opt-in maintenance worker. MaxBytes is a logical
+// output-byte admission budget, not a physical/network bandwidth limit. Use the
+// designated maintenance mount's upload/download limits as well.
+type ReclaimConfig struct {
+	Interval  time.Duration
+	MinAge    time.Duration
+	ScanLimit int
+	MaxChunks int
+	MaxBytes  uint64
+	MinBytes  uint64
+	MinGain   uint // estimated reclaimed bytes / rewritten bytes, in percent
+}
+
+func DefaultReclaimConfig() ReclaimConfig {
+	return ReclaimConfig{
+		MinAge: 10 * time.Minute, ScanLimit: 128, MaxChunks: 1,
+		MaxBytes: ChunkSize, MinBytes: 64 << 10, MinGain: 25,
+	}
+}
+
+func (c ReclaimConfig) normalized() ReclaimConfig {
+	d := DefaultReclaimConfig()
+	if c.Interval < time.Second {
+		c.Interval = time.Second
+	}
+	if c.MinAge <= 0 {
+		c.MinAge = d.MinAge
+	}
+	if c.ScanLimit <= 0 {
+		c.ScanLimit = d.ScanLimit
+	}
+	c.ScanLimit = min(c.ScanLimit, 4096)
+	if c.MaxChunks <= 0 {
+		c.MaxChunks = d.MaxChunks
+	}
+	c.MaxChunks = min(c.MaxChunks, c.ScanLimit)
+	if c.MaxBytes == 0 {
+		c.MaxBytes = d.MaxBytes
+	}
+	if c.MinBytes == 0 {
+		c.MinBytes = d.MinBytes
+	}
+	if c.MinGain == 0 {
+		c.MinGain = d.MinGain
+	}
+	c.MinGain = min(c.MinGain, 10000)
+	return c
+}
+
+// A nil next cursor denotes end-of-scan. Backends page over stored records,
+// never over a file's logical length, and release read transactions before any
+// object compaction. Redis SCAN COUNT remains a server-side work hint.
+type reclaimPage struct {
+	next    interface{}
+	chunks  []cchunk
+	scanned int
+}
+
+type reclaimKey struct {
+	inode Ino
+	index uint32
+}
+
+type reclaimCandidate struct {
+	key         reclaimKey
+	fingerprint [32]byte
+	due         time.Time
+	retries     int
+}
+
+type reclaimStats struct {
+	Scanned, Observed, Checked, Changed, Rejected, Deferred int
+	Attempts, Succeeded, Failed, Pending                    int
+	WriteBytes, EstimatedGain                               uint64
+}
+
+type reclaimWorker struct {
+	m       *baseMeta
+	conf    ReclaimConfig
+	cursor  interface{}
+	pending []reclaimCandidate
+	queued  map[reclaimKey]bool
+	now     func() time.Time
+}
+
+func newReclaimWorker(m *baseMeta, conf ReclaimConfig) *reclaimWorker {
+	return &reclaimWorker{m: m, conf: conf.normalized(), queued: make(map[reclaimKey]bool), now: time.Now}
+}
+
+func (m *baseMeta) startReclaim(ctx Context) {
+	if m.conf.Reclaim == nil || m.conf.Reclaim.Interval <= 0 || m.conf.ReadOnly || m.conf.NoBGJob || m.conf.MaxDeletes <= 0 {
+		return
+	}
+	w := newReclaimWorker(m, *m.conf.Reclaim)
+	m.sessWG.Add(1)
+	go func() {
+		defer m.sessWG.Done()
+		for {
+			timer := time.NewTimer(utils.JitterIt(w.conf.Interval))
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+			if ctx.Canceled() {
+				return
+			}
+			start := time.Now()
+			stats, err := w.tick(ctx)
+			if err != nil {
+				logger.Warnf("Reclaim scan root=%d: %s", m.root, err)
+			}
+			logger.Infof("Reclaim root=%d duration=%s stats=%+v", m.root, time.Since(start), stats)
+		}
+	}()
+}
+
+func reclaimFingerprint(ss []*slice) [32]byte {
+	h := sha256.New()
+	for _, s := range ss {
+		_, _ = h.Write(marshalSlice(s.pos, s.id, s.size, s.off, s.len))
+	}
+	var sum [32]byte
+	copy(sum[:], h.Sum(nil))
+	return sum
+}
+
+// Estimate unique source bytes whose references this batch removes. A source
+// still present in the skipped prefix or unprocessed tail cannot be reclaimed
+// by this batch. Cross-file shared references may reduce the actual saving.
+func reclaimGain(all []*slice, begin, end int, size uint32) uint64 {
+	sources := make(map[uint64]uint32)
+	for _, s := range all[begin:end] {
+		if s.id != 0 {
+			sources[s.id] = s.size
+		}
+	}
+	for i, s := range all {
+		if i < begin || i >= end {
+			delete(sources, s.id)
+		}
+	}
+	var total uint64
+	for _, n := range sources {
+		total += uint64(n)
+	}
+	if total <= uint64(size) {
+		return 0
+	}
+	return total - uint64(size)
+}
+
+func (w *reclaimWorker) worthwhile(gain uint64, size uint32) bool {
+	return gain >= w.conf.MinBytes && float64(gain)/float64(size) >= float64(w.conf.MinGain)/100
+}
+
+func (w *reclaimWorker) observe(ctx Context, c cchunk, stats *reclaimStats) {
+	k := reclaimKey{c.inode, c.indx}
+	if w.queued[k] {
+		return
+	}
+	if _, ok := w.inScope(ctx, c.inode); !ok {
+		return
+	}
+	all, st := w.m.en.doRead(ctx, c.inode, c.indx)
+	stats.Observed++
+	if st != 0 || len(all) < 2 {
+		return
+	}
+	end := min(len(all), maxCompactSlices)
+	begin := skipSome(all[:end])
+	_, size, _ := compactChunk(all[begin:end])
+	if end-begin < 2 || size == 0 || uint64(size) > w.conf.MaxBytes || !w.worthwhile(reclaimGain(all, begin, end, size), size) {
+		stats.Rejected++
+		return
+	}
+	w.pending = append(w.pending, reclaimCandidate{key: k, fingerprint: reclaimFingerprint(all), due: w.now().Add(w.conf.MinAge)})
+	w.queued[k] = true
+}
+
+// Hard-linked files are conservatively excluded, avoiding duplicate work and
+// ambiguous subtree ownership. Directory ancestry is bounded and rechecked at
+// execution; concurrent namespace changes are still best-effort scope changes.
+func (w *reclaimWorker) inScope(ctx Context, inode Ino) (uint8, bool) {
+	var attr Attr
+	if ctx.Canceled() || w.m.en.doGetAttr(ctx, inode, &attr) != 0 || attr.Typ != TypeFile || attr.Nlink != 1 {
+		return 0, false
+	}
+	tier := attr.Tier
+	parent := attr.Parent
+	for depth := 0; depth < 64; depth++ {
+		if ctx.Canceled() || parent == 0 || parent >= TrashInode {
+			return 0, false
+		}
+		if parent == w.m.root {
+			return tier, true
+		}
+		if parent == RootInode || w.m.en.doGetAttr(ctx, parent, &attr) != 0 || attr.Typ != TypeDirectory {
+			return 0, false
+		}
+		parent = attr.Parent
+	}
+	return 0, false
+}
+
+func (w *reclaimWorker) tick(ctx Context) (stats reclaimStats, err error) {
+	defer func() { stats.Pending = len(w.pending) }()
+	// A fixed cohort per tick prevents the same failed/busy chunk from being
+	// retried repeatedly in a single budget period. Changed candidates leave
+	// the queue, allowing the persistent scan cursor to reach later cold work.
+	for n := len(w.pending); n > 0 && !ctx.Canceled(); n-- {
+		if stats.Attempts >= w.conf.MaxChunks || stats.WriteBytes >= w.conf.MaxBytes {
+			break
+		}
+		c := w.pending[0]
+		w.pending = w.pending[1:]
+		now := w.now()
+		if now.Before(c.due) {
+			w.pending = append(w.pending, c)
+			continue
+		}
+		delete(w.queued, c.key)
+		tier, ok := w.inScope(ctx, c.key.inode)
+		if !ok {
+			stats.Rejected++
+			continue
+		}
+		stats.Checked++
+		retry, budget := true, false
+		admitted := false
+		var plannedGain uint64
+		success := w.m.compactChunkChecked(ctx, c.key.inode, c.key.index, false, false, int(tier), func(all []*slice, begin, end int, size uint32) bool {
+			retry = false
+			if reclaimFingerprint(all) != c.fingerprint {
+				stats.Changed++
+				return false
+			}
+			gain := reclaimGain(all, begin, end, size)
+			if !w.worthwhile(gain, size) || uint64(size) > w.conf.MaxBytes {
+				stats.Rejected++
+				return false
+			}
+			if uint64(size) > w.conf.MaxBytes-stats.WriteBytes {
+				budget = true
+				return false
+			}
+			// Charge before allocating/uploading, including failures and CAS
+			// waste. Counters do not claim these bytes were actually uploaded.
+			stats.Attempts++
+			stats.WriteBytes += uint64(size)
+			plannedGain = gain
+			admitted = true
+			return true
+		})
+		if success {
+			stats.Succeeded++
+			stats.EstimatedGain += plannedGain
+		} else if admitted {
+			stats.Failed++
+			retry = true
+		}
+		if budget {
+			// Preserve FIFO priority so a large candidate is not starved by
+			// smaller ones consuming the next round's budget first.
+			w.pending = append([]reclaimCandidate{c}, w.pending...)
+			w.queued[c.key] = true
+			stats.Deferred++
+			break
+		}
+		if retry && c.retries < 3 {
+			c.retries++
+			c.due = now.Add(w.conf.Interval * time.Duration(1<<c.retries))
+			w.pending = append(w.pending, c)
+			w.queued[c.key] = true
+			stats.Deferred++
+		}
+	}
+	if ctx.Canceled() {
+		return stats, ctx.Err()
+	}
+	// Pause discovery when the bounded queue is full. All candidates either
+	// finish, change, or exhaust bounded retries, so later pages get a turn.
+	room := w.conf.ScanLimit - len(w.pending)
+	if room == 0 {
+		return stats, nil
+	}
+	page, err := w.m.en.scanReclaimPage(ctx, w.cursor, room)
+	if err != nil {
+		w.cursor = nil // retry discovery from durable metadata after errors
+		return stats, err
+	}
+	w.cursor = page.next
+	stats.Scanned = page.scanned
+	for _, c := range page.chunks {
+		if ctx.Canceled() {
+			return stats, ctx.Err()
+		}
+		w.observe(ctx, c, &stats)
+	}
+	return stats, nil
+}
