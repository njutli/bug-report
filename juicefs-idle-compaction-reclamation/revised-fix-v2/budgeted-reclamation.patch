+	"time"
+)
+
+// This file also compiles on the pinned unmodified release. JSON ignores its
+// unknown Reclaim field there: the same real-session test then fails on retained
+// records, rather than on missing APIs or compilation errors.
+func TestReclaimRegression(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite"} {
+		t.Run(backend, func(t *testing.T) {
+			conf := testConfig()
+			if err := json.Unmarshal([]byte(`{"Reclaim":{"Interval":1000000000,"MinAge":20000000,"ScanLimit":128,"MaxChunks":1,"MaxBytes":67108864,"MinBytes":65536,"MinGain":25}}`), conf); err != nil {
+				t.Fatal(err)
+			}
+			var client Meta
+			var err error
+			if backend == "sqlite" {
+				client, err = newSQLMeta("sqlite3", filepath.Join(t.TempDir(), "regression.db"), conf)
+			} else {
+				client, err = newKVMeta("memkv", t.Name(), conf)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Shutdown()
+			if err = client.Reset(); err != nil {
+				t.Fatal(err)
+			}
+			if err = client.Init(testFormat(), true); err != nil {
+				t.Fatal(err)
+			}
+			m := client.(interface{ getBase() *baseMeta }).getBase()
+			m.OnMsg(DeleteSlice, func(...interface{}) error { return nil })
+			m.OnMsg(CompactChunk, func(...interface{}) error { return nil })
+			ctx := Background()
+			var inode Ino
+			if st := m.Create(ctx, RootInode, "missed", 0600, 0, 0, &inode, nil); st != 0 {
+				t.Fatal(st)
+			}
+			for i := 0; i < 99; i++ {
+				var id uint64
+				if st := m.NewSlice(ctx, &id); st != 0 {
+					t.Fatal(st)
+				}
+				var n int
+				var d dirStat
+				var a Attr
+				if st := m.en.doWrite(ctx, inode, 0, 0, Slice{Id: id, Size: 65536, Len: 65536}, time.Now(), &n, &d, &a); st != 0 {
+					t.Fatal(st)
+				}
+			}
+			for k := uint64(10000); k < 10012; k++ {
+				m.compacting[k] = true
+			}
+			m.compactChunk(inode, 0, false, false, 0)
+			ss, st := m.en.doRead(ctx, inode, 0)
+			if st != 0 || len(ss) != 99 {
+				t.Fatal("fixture did not exercise a skipped trigger")
+			}
+			clear(m.compacting)
+			if err = m.NewSession(true); err != nil {
+				t.Fatal(err)
+			}
+			defer m.CloseSession()
+			deadline := time.Now().Add(5 * time.Second)
+			for time.Now().Before(deadline) {
+				// Engine reads observe history without triggering foreground Read.
+				ss, st = m.en.doRead(ctx, inode, 0)
+				if st != 0 {
+					t.Fatal(st)
+				}
+				if len(ss) == 1 {
+					return
+				}
+				time.Sleep(50 * time.Millisecond)
+			}
+			t.Fatalf("RECLAIM_MISSING: no user IO/manual compact after skipped trigger; retained %d records", len(ss))
+		})
+	}
+}
