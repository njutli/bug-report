+const reclaimSQLAfter = "(inode, indx) > (?, ?)"
+
+func (m *dbMeta) scanReclaimPage(ctx Context, cursor interface{}, limit int) (reclaimPage, error) {
+	var rows []chunk
+	err := m.roTxn(ctx, func(s *xorm.Session) error {
+		rows = nil
+		q := s.Table(&chunk{}).OrderBy("inode, indx").Limit(limit)
+		if cursor != nil {
+			last := cursor.(reclaimKey)
+			q = q.Where(reclaimSQLAfter, last.inode, last.index)
+		}
+		return q.Find(&rows)
+	})
+	page := reclaimPage{scanned: len(rows)}
+	for _, c := range rows {
+		if len(c.Slices) > sliceBytes {
+			page.chunks = append(page.chunks, cchunk{c.Inode, c.Indx, len(c.Slices) / sliceBytes})
+		}
+	}
+	if len(rows) == limit {
+		last := rows[len(rows)-1]
+		page.next = reclaimKey{last.Inode, last.Indx}
+	}
+	return page, err
+}
