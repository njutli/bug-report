+func reclaimTestMeta(t *testing.T, backend string) *baseMeta {
+	t.Helper()
+	var client Meta
+	var err error
+	switch backend {
+	case "sqlite":
+		client, err = newSQLMeta("sqlite3", filepath.Join(t.TempDir(), "reclaim.db"), testConfig())
+	case "redis":
+		socket := os.Getenv("RECLAIM_TEST_REDIS_SOCKET")
+		if socket == "" {
+			t.Skip("set RECLAIM_TEST_REDIS_SOCKET to an isolated Redis Unix socket")
+		}
+		client, err = newRedisMeta("unix", socket+"?db=0", testConfig())
+	default:
+		client, err = newKVMeta("memkv", t.Name(), testConfig())
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Reset(); err != nil {
+		t.Fatal(err)
+	}
+	if err = client.Init(testFormat(), true); err != nil {
+		t.Fatal(err)
+	}
+	m := client.(interface{ getBase() *baseMeta }).getBase()
+	m.OnMsg(DeleteSlice, func(...interface{}) error { return nil })
+	m.OnMsg(CompactChunk, func(...interface{}) error { return nil })
+	t.Cleanup(func() { _ = client.Shutdown() })
+	return m
+}
+
+func reclaimFile(t *testing.T, m *baseMeta, parent Ino, name string) Ino {
+	t.Helper()
+	var inode Ino
+	if st := m.Create(Background(), parent, name, 0600, 0, 0, &inode, nil); st != 0 {
+		t.Fatal(st)
+	}
+	return inode
+}
+
+func reclaimWrite(t *testing.T, m *baseMeta, inode Ino, pos, size uint32, public bool) {
+	t.Helper()
+	var id uint64
+	ctx := Background()
+	if st := m.NewSlice(ctx, &id); st != 0 {
+		t.Fatal(st)
+	}
+	s := Slice{Id: id, Size: size, Len: size}
+	var st syscall.Errno
+	if public {
+		st = m.Write(ctx, inode, 0, pos, s, time.Now())
+	} else {
+		var n int
+		var d dirStat
+		var a Attr
+		st = m.en.doWrite(ctx, inode, 0, pos, s, time.Now(), &n, &d, &a)
+	}
+	if st != 0 {
+		t.Fatal(st)
+	}
+}
+
+func reclaimHistory(t *testing.T, m *baseMeta, name string, n int) Ino {
+	t.Helper()
+	ino := reclaimFile(t, m, RootInode, name)
+	for i := 0; i < n; i++ {
+		reclaimWrite(t, m, ino, 0, 64<<10, false)
+	}
+	return ino
+}
+
+func reclaimRecords(t *testing.T, m *baseMeta, ino Ino) int {
+	t.Helper()
+	ss, st := m.en.doRead(Background(), ino, 0)
+	if st != 0 {
+		t.Fatal(st)
+	}
+	return len(ss)
+}
+
+func reclaimTestWorker(m *baseMeta) (*reclaimWorker, *time.Time) {
+	c := DefaultReclaimConfig()
+	c.Interval, c.MinAge = time.Second, 10*time.Second
+	now := time.Unix(1000, 0)
+	w := newReclaimWorker(m, c)
+	w.now = func() time.Time { return now }
+	return w, &now
+}
+
+func reclaimTick(t *testing.T, w *reclaimWorker) reclaimStats {
+	t.Helper()
+	stats, err := w.tick(Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if stats.Scanned > w.conf.ScanLimit || stats.Checked > w.conf.ScanLimit || stats.Pending > w.conf.ScanLimit || stats.Attempts > w.conf.MaxChunks || stats.WriteBytes > w.conf.MaxBytes {
+		t.Fatalf("budget exceeded: %+v conf=%+v", stats, w.conf)
+	}
+	return stats
+}
+
+func reclaimObserve(t *testing.T, w *reclaimWorker, want int) {
+	t.Helper()
+	for i := 0; i < 1000 && len(w.pending) < want; i++ {
+		s := reclaimTick(t, w)
+		if s.Attempts != 0 {
+			t.Fatalf("compacted before cold observation: %+v", s)
+		}
+	}
+	if len(w.pending) != want {
+		t.Fatalf("pending=%d want=%d", len(w.pending), want)
+	}
+}
+
+func TestReclaimMechanism(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			for _, scenario := range []string{"missed-trigger", "below-threshold", "same-chunk-busy", "object-failure", "bounded-batches", "restart"} {
+				t.Run(scenario, func(t *testing.T) {
+					m := reclaimTestMeta(t, backend)
+					records := 99
+					if scenario == "below-threshold" {
+						records = 3
+					}
+					if scenario == "bounded-batches" {
+						records = maxCompactSlices + 24
+					}
+					ino := reclaimHistory(t, m, "cold", records)
+					for k := uint64(10000); k < 10012; k++ {
+						m.compacting[k] = true
+					}
+					m.compactChunk(ino, 0, false, false, 0)
+					if reclaimRecords(t, m, ino) != records {
+						t.Fatal("fixture was not skipped")
+					}
+					clear(m.compacting)
+					w, now := reclaimTestWorker(m)
+					reclaimObserve(t, w, 1)
+					*now = now.Add(9 * time.Second)
+					if s := reclaimTick(t, w); s.Attempts != 0 {
+						t.Fatal("min-age was bypassed")
+					}
+					if scenario == "restart" {
+						w, now = reclaimTestWorker(m)
+						reclaimObserve(t, w, 1)
+						if reclaimRecords(t, m, ino) != records {
+							t.Fatal("restart bypassed cold observation")
+						}
+					}
+					*now = now.Add(w.conf.MinAge)
+					if scenario == "same-chunk-busy" {
+						m.compacting[uint64(ino)] = true
+						if s := reclaimTick(t, w); s.Attempts != 0 || reclaimRecords(t, m, ino) != records {
+							t.Fatal("busy gate bypassed")
+						}
+						delete(m.compacting, uint64(ino))
+						*now = now.Add(3 * time.Second)
+					}
+					if scenario == "object-failure" {
+						m.OnMsg(CompactChunk, func(...interface{}) error { return errors.New("injected storage failure") })
+						s := reclaimTick(t, w)
+						if s.Failed != 1 || s.WriteBytes != 64<<10 || reclaimRecords(t, m, ino) != records {
+							t.Fatalf("failure not accounted: %+v", s)
+						}
+						m.OnMsg(CompactChunk, func(...interface{}) error { return nil })
+						*now = now.Add(3 * time.Second)
+					}
+					s := reclaimTick(t, w)
+					want := 1
+					if scenario == "bounded-batches" {
+						want = 25
+					}
+					if s.Succeeded != 1 || reclaimRecords(t, m, ino) != want {
+						t.Fatalf("recovery failed: %+v records=%d", s, reclaimRecords(t, m, ino))
+					}
+					if scenario == "bounded-batches" {
+						reclaimObserve(t, w, 1)
+						*now = now.Add(w.conf.MinAge)
+						if s := reclaimTick(t, w); s.Succeeded != 1 || reclaimRecords(t, m, ino) != 1 {
+							t.Fatalf("tail not recovered: %+v", s)
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestReclaimPolicy(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		for _, tc := range []struct {
+			name   string
+			writes [][2]uint32
+			want   bool
+		}{
+			{"small-overwrite", [][2]uint32{{0, ChunkSize}, {ChunkSize / 2, 256 << 10}}, false},
+			{"no-garbage", [][2]uint32{{0, 256 << 10}, {256 << 10, 256 << 10}}, false},
+			{"internal-hole", [][2]uint32{{0, 256 << 10}, {ChunkSize - 256<<10, 256 << 10}}, false},
+			{"large-intact", [][2]uint32{{0, ChunkSize / 2}, {ChunkSize / 2, ChunkSize / 2}}, false},
+			{"useful-partial-overwrite", [][2]uint32{{0, ChunkSize}, {0, ChunkSize / 4}}, true},
+		} {
+			t.Run(backend+"/"+tc.name, func(t *testing.T) {
+				m := reclaimTestMeta(t, backend)
+				ino := reclaimFile(t, m, RootInode, "policy")
+				for _, wr := range tc.writes {
+					reclaimWrite(t, m, ino, wr[0], wr[1], true)
+				}
+				calls := 0
+				m.OnMsg(CompactChunk, func(...interface{}) error { calls++; return nil })
+				w, now := reclaimTestWorker(m)
+				for i := 0; i < 5; i++ {
+					reclaimTick(t, w)
+					*now = now.Add(w.conf.MinAge)
+				}
+				if (calls == 1) != tc.want || calls > 1 {
+					t.Fatalf("calls=%d want compact=%v", calls, tc.want)
+				}
+			})
+		}
+	}
+}
+
+func TestReclaimAmplificationComparison(t *testing.T) {
+	for _, policy := range []string{"v1-sweep", "v2-reclaim"} {
+		t.Run(policy, func(t *testing.T) {
+			m := reclaimTestMeta(t, "memkv")
+			ino := reclaimFile(t, m, RootInode, "small-overwrites")
+			reclaimWrite(t, m, ino, 0, ChunkSize, true)
+			var rewritten uint64
+			m.OnMsg(CompactChunk, func(args ...interface{}) error {
+				for _, s := range args[0].([]Slice) {
+					rewritten += uint64(s.Len)
+				}
+				return nil
+			})
+			w, now := reclaimTestWorker(m)
+			for i := 0; i < 3; i++ {
+				reclaimWrite(t, m, ino, ChunkSize/2, 256<<10, true)
+				if policy == "v1-sweep" {
+					// The v1 sweep directly invokes ordinary compaction per chunk.
+					m.compactChunk(ino, 0, false, false, 0)
+				} else {
+					reclaimTick(t, w)
+					*now = now.Add(w.conf.MinAge)
+					reclaimTick(t, w)
+				}
+			}
+			want := uint64(0)
+			if policy == "v1-sweep" {
+				want = 3 * ChunkSize
+			}
+			if rewritten != want {
+				t.Fatalf("rewritten=%d want=%d", rewritten, want)
+			}
+			t.Logf("user_delta_bytes=786432 compact_rewrite_bytes=%d amplification=%.0f", rewritten, float64(rewritten)/786432)
+		})
+	}
+}
+
+func TestReclaimChangingChunksAndFairness(t *testing.T) {
+	m := reclaimTestMeta(t, "memkv")
+	hot := reclaimHistory(t, m, "hot", 3)
+	var cold []Ino
+	for i := 0; i < 7; i++ {
+		cold = append(cold, reclaimHistory(t, m, fmt.Sprintf("cold-%d", i), 3))
+	}
+	w, now := reclaimTestWorker(m)
+	w.conf.ScanLimit, w.conf.MinAge = 2, 3*time.Second
+	for i := 0; i < 200; i++ {
+		reclaimWrite(t, m, hot, 0, 64<<10, false)
+		reclaimTick(t, w)
+		*now = now.Add(time.Second)
+	}
+	if reclaimRecords(t, m, hot) != 203 {
+		t.Fatal("changing chunk compacted")
+	}
+	for _, ino := range cold {
+		if reclaimRecords(t, m, ino) != 1 {
+			t.Fatalf("cold inode %d starved behind bounded queue", ino)
+		}
+	}
+}
+
+type reclaimReadCounter struct {
+	engine
+	reads int
+}
+
+func (e *reclaimReadCounter) doRead(ctx Context, ino Ino, index uint32) ([]*slice, syscall.Errno) {
+	e.reads++
+	return e.engine.doRead(ctx, ino, index)
+}
+
+func TestReclaimSparsePaging(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			m := reclaimTestMeta(t, backend)
+			ino := reclaimFile(t, m, RootInode, "one-terabyte-hole")
+			if st := m.Truncate(Background(), ino, 0, 1<<40, nil, false); st != 0 {
+				t.Fatal(st)
+			}
+			counter := &reclaimReadCounter{engine: m.en}
+			m.en = counter
+			w, _ := reclaimTestWorker(m)
+			w.conf.ScanLimit = 2
+			scanned, steps := 0, 0
+			for {
+				s := reclaimTick(t, w)
+				scanned += s.Scanned
+				steps++
+				if w.cursor == nil {
+					break
+				}
+				if steps > 100 {
+					t.Fatal("cursor did not reach end")
+				}
+			}
+			if scanned > 16 || counter.reads != 0 {
+				t.Fatalf("sparse scan scaled with logical length: scanned=%d reads=%d", scanned, counter.reads)
+			}
+			t.Logf("logical_bytes=%d pages=%d stored_records_scanned=%d chunk_reads=%d", uint64(1<<40), steps, scanned, counter.reads)
+		})
+	}
+}
+
+func TestReclaimSubdirAndBudget(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			m := reclaimTestMeta(t, backend)
+			outside := reclaimHistory(t, m, "outside", 3)
+			var dir Ino
+			if st := m.Mkdir(Background(), RootInode, "scope", 0700, 0, 0, &dir, nil); st != 0 {
+				t.Fatal(st)
+			}
+			var inside []Ino
+			for i := 0; i < 3; i++ {
+				ino := reclaimFile(t, m, dir, fmt.Sprintf("inside-%d", i))
+				for j := 0; j < 3; j++ {
+					reclaimWrite(t, m, ino, 0, 64<<10, false)
+				}
+				inside = append(inside, ino)
+			}
+			m.chroot(dir)
+			w, now := reclaimTestWorker(m)
+			w.conf.MaxBytes, w.conf.MaxChunks = 64<<10, 3
+			reclaimObserve(t, w, 3)
+			*now = now.Add(w.conf.MinAge)
+			m.OnMsg(CompactChunk, func(...interface{}) error { return errors.New("budgeted failure") })
+			s := reclaimTick(t, w)
+			if s.Attempts != 1 || s.WriteBytes != 64<<10 || s.Failed != 1 {
+				t.Fatalf("failure did not consume budget: %+v", s)
+			}
+			m.OnMsg(CompactChunk, func(...interface{}) error { return nil })
+			for i := 0; i < 10; i++ {
+				*now = now.Add(w.conf.MinAge)
+				reclaimTick(t, w)
+			}
+			if reclaimRecords(t, m, outside) != 3 {
+				t.Fatal("escaped subtree")
+			}
+			for _, ino := range inside {
+				if reclaimRecords(t, m, ino) != 1 {
+					t.Fatal("budgeted work lost")
+				}
+			}
+		})
+	}
+}
+
+func TestReclaimSchedulerGates(t *testing.T) {
+	for _, mode := range []string{"nil", "disabled", "readonly", "no-bgjob", "no-deletes", "enabled"} {
+		t.Run(mode, func(t *testing.T) {
+			m := reclaimTestMeta(t, "memkv")
+			_ = reclaimHistory(t, m, "cold", 3)
+			c := DefaultReclaimConfig()
+			c.Interval, c.MinAge = time.Second, 20*time.Millisecond
+			m.conf.Reclaim = &c
+			switch mode {
+			case "nil":
+				m.conf.Reclaim = nil
+			case "disabled":
+				c.Interval = 0
+			case "readonly":
+				m.conf.ReadOnly = true
+			case "no-bgjob":
+				m.conf.NoBGJob = true
+			case "no-deletes":
+				m.conf.MaxDeletes = 0
+			}
+			var calls atomic.Int32
+			done := make(chan struct{}, 1)
+			m.OnMsg(CompactChunk, func(...interface{}) error { calls.Add(1); done <- struct{}{}; return nil })
+			ctx := Background()
+			m.sessCtx = ctx
+			m.startReclaim(ctx)
+			if mode == "enabled" {
+				select {
+				case <-done:
+				case <-time.After(6 * time.Second):
+					t.Error("scheduler did not reclaim")
+				}
+			} else {
+				select {
+				case <-done:
+					t.Error("disabled worker ran")
+				case <-time.After(1100 * time.Millisecond):
+				}
+			}
+			ctx.Cancel()
+			m.sessWG.Wait()
+			if mode != "enabled" && calls.Load() != 0 {
+				t.Fatal("disabled callback")
+			}
+		})
+	}
+}
