+type reclaimObjectCounter struct {
+	object.ObjectStorage
+	puts    atomic.Int64
+	bytes   atomic.Int64
+	deletes atomic.Int64
+}
+
+func (b *reclaimObjectCounter) Put(ctx context.Context, key string, in io.Reader, getters ...object.AttrGetter) error {
+	data, err := io.ReadAll(in)
+	if err != nil {
+		return err
+	}
+	if err = b.ObjectStorage.Put(ctx, key, bytes.NewReader(data), getters...); err == nil {
+		b.puts.Add(1)
+		b.bytes.Add(int64(len(data)))
+	}
+	return err
+}
+
+func (b *reclaimObjectCounter) Delete(ctx context.Context, key string, getters ...object.AttrGetter) error {
+	err := b.ObjectStorage.Delete(ctx, key, getters...)
+	if err == nil {
+		b.deletes.Add(1)
+	}
+	return err
+}
