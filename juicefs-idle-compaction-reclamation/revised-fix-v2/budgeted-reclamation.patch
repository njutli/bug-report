+func (m *kvMeta) scanReclaimPage(ctx Context, cursor interface{}, limit int) (reclaimPage, error) {
+	var page reclaimPage
+	start := m.fmtKey("A")
+	if cursor != nil {
+		start = nextKey(cursor.([]byte))
+	}
+	end := nextKey(m.fmtKey("A"))
+	err := m.client.txn(ctx, func(tx *kvTxn) error {
+		page = reclaimPage{} // transaction retries must not duplicate results
+		tx.scan(start, end, false, func(k, v []byte) bool {
+			if ctx.Canceled() {
+				return false
+			}
+			page.scanned++
+			page.next = append([]byte(nil), k...)
+			if len(k) == 14 && k[9] == 'C' && len(v) > sliceBytes {
+				page.chunks = append(page.chunks, cchunk{m.decodeInode(k[1:9]), binary.BigEndian.Uint32(k[10:]), len(v) / sliceBytes})
+			}
+			return page.scanned < limit
+		})
+		if ctx.Canceled() {
+			return ctx.Err()
+		}
+		if page.scanned < limit {
+			page.next = nil
+		}
+		return nil
+	}, 0)
+	return page, err
+}
