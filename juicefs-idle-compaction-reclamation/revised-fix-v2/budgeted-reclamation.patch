+func TestReclaimCancellation(t *testing.T) {
+	m := reclaimTestMeta(t, "memkv")
+	_ = reclaimHistory(t, m, "first", 3)
+	_ = reclaimHistory(t, m, "second", 3)
+	w, now := reclaimTestWorker(m)
+	w.conf.MaxChunks = 2
+	reclaimObserve(t, w, 2)
+	*now = now.Add(w.conf.MinAge)
+	ctx := Background()
+	entered, release, finished := make(chan struct{}, 2), make(chan struct{}), make(chan struct{})
+	m.OnMsg(CompactChunk, func(...interface{}) error { entered <- struct{}{}; <-release; return nil })
+	go func() { _, _ = w.tick(ctx); close(finished) }()
+	<-entered
+	ctx.Cancel()
+	select {
+	case <-finished:
+		t.Error("returned before in-flight callback finished")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("did not stop after callback")
+	}
+	select {
+	case <-entered:
+		t.Fatal("admitted work after cancellation")
+	default:
+	}
+}
