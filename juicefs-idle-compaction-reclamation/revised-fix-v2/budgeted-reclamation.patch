+func TestReclaimPagingCompleteness(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite", "redis"} {
+		t.Run(backend, func(t *testing.T) {
+			m := reclaimTestMeta(t, backend)
+			want := make(map[reclaimKey]bool)
+			for i := 0; i < 5; i++ {
+				ino := reclaimFile(t, m, RootInode, fmt.Sprintf("sparse-%d", i))
+				for _, index := range []uint32{0, 42, 16383} {
+					want[reclaimKey{ino, index}] = true
+					for j := 0; j < 2; j++ {
+						var id uint64
+						ctx := Background()
+						if st := m.NewSlice(ctx, &id); st != 0 {
+							t.Fatal(st)
+						}
+						var n int
+						var d dirStat
+						var a Attr
+						if st := m.en.doWrite(ctx, ino, index, 0, Slice{Id: id, Size: 65536, Len: 65536}, time.Now(), &n, &d, &a); st != 0 {
+							t.Fatal(st)
+						}
+					}
+				}
+			}
+			seen := make(map[reclaimKey]bool)
+			var cursor interface{}
+			for pageCount := 0; ; pageCount++ {
+				if pageCount > 1000 {
+					t.Fatal("pagination did not finish")
+				}
+				p, err := m.en.scanReclaimPage(Background(), cursor, 2)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if p.scanned > 2 || len(p.chunks) > 2 {
+					t.Fatal("page exceeded limit")
+				}
+				for _, c := range p.chunks {
+					k := reclaimKey{c.inode, c.indx}
+					if !want[k] {
+						t.Fatalf("unexpected candidate %+v", k)
+					}
+					seen[k] = true // Redis SCAN may repeat keys
+				}
+				cursor = p.next
+				if cursor == nil {
+					break
+				}
+			}
+			if len(seen) != len(want) {
+				t.Fatalf("lost page candidates: %d / %d", len(seen), len(want))
+			}
+			w, now := reclaimTestWorker(m)
+			w.conf.ScanLimit = 2
+			for i := 0; i < 200; i++ {
+				reclaimTick(t, w)
+				*now = now.Add(time.Second)
+			}
+			for k := range want {
+				ss, st := m.en.doRead(Background(), k.inode, k.index)
+				if st != 0 || len(ss) != 1 {
+					t.Fatalf("candidate not eventually reclaimed: %+v records=%d errno=%s", k, len(ss), st)
+				}
+			}
+		})
+	}
