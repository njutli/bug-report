+func TestReclaimMixedBudgetKeepsFIFO(t *testing.T) {
+	m := reclaimTestMeta(t, "memkv")
+	w, now := reclaimTestWorker(m)
+	w.conf.MaxBytes, w.conf.MaxChunks = 128<<10, 3
+	var targets []Ino
+	for i, size := range []uint32{64 << 10, 128 << 10, 64 << 10} {
+		ino := reclaimFile(t, m, RootInode, fmt.Sprintf("size-%d", i))
+		for j := 0; j < 3; j++ {
+			reclaimWrite(t, m, ino, 0, size, false)
+		}
+		targets = append(targets, ino)
+		var stats reclaimStats
+		w.observe(Background(), cchunk{inode: ino, indx: 0, slices: 3}, &stats)
+	}
+	*now = now.Add(w.conf.MinAge)
+	s := reclaimTick(t, w)
+	if s.WriteBytes != 64<<10 || s.Attempts != 1 || s.Deferred != 1 || len(w.pending) != 2 || w.pending[0].key.inode != targets[1] {
+		t.Fatalf("overspent budget or lost FIFO: %+v queue=%+v", s, w.pending)
+	}
+	*now = now.Add(time.Second)
+	s = reclaimTick(t, w)
+	if s.WriteBytes != 128<<10 || s.Attempts != 1 || reclaimRecords(t, m, targets[1]) != 1 || reclaimRecords(t, m, targets[2]) != 3 {
+		t.Fatalf("large candidate starved: %+v", s)
+	}
+	*now = now.Add(time.Second)
+	if s = reclaimTick(t, w); s.Succeeded != 1 || reclaimRecords(t, m, targets[2]) != 1 {
+		t.Fatalf("remaining work lost: %+v", s)
+	}
