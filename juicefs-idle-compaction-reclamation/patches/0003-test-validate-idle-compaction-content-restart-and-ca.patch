+
+func TestIdleCompactionMountConfig(t *testing.T) {
+	for _, value := range []string{"0", "1h", "15s"} {
+		t.Run(value, func(t *testing.T) {
+			flags := flag.NewFlagSet("idle-compact", flag.ContinueOnError)
+			flags.Duration("compact-interval", 0, "")
+			flags.String("atime-mode", "noatime", "")
+			if err := flags.Parse([]string{"--compact-interval", value}); err != nil {
+				t.Fatal(err)
+			}
+			conf := getMetaConf(cli.NewContext(nil, flags, nil), "/scope", false)
+			want, err := time.ParseDuration(value)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if conf.CompactInterval != want {
+				t.Fatalf("got %s, want %s", conf.CompactInterval, want)
+			}
+		})
+	}
+}
