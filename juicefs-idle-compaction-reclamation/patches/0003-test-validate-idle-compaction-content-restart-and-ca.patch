+func TestIdleCompactionCancellationWaitsForInFlight(t *testing.T) {
+	m := idleTestMeta(t, "memkv")
+	_ = idleTestFile(t, m, RootInode, "a", 3)
+	_ = idleTestFile(t, m, RootInode, "b", 3)
+	m.conf.CompactInterval = time.Second
+	ctx := Background()
+	m.sessCtx = ctx
+	entered := make(chan struct{}, 2)
+	release := make(chan struct{})
+	m.OnMsg(CompactChunk, func(...interface{}) error {
+		entered <- struct{}{}
+		<-release
+		return nil
+	})
+	m.startIdleCompaction(ctx)
+	select {
+	case <-entered:
+	case <-time.After(5 * time.Second):
+		ctx.Cancel()
+		close(release)
+		m.sessWG.Wait()
+		t.Fatal("scheduler did not enter callback")
+	}
+	ctx.Cancel()
+	done := make(chan struct{})
+	go func() { m.sessWG.Wait(); close(done) }()
+	select {
+	case <-done:
+		t.Error("session task returned before its object callback finished")
+	case <-time.After(50 * time.Millisecond):
+		// Document the limitation: cancellation cannot interrupt the callback.
+	}
+	close(release)
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("task did not exit after callback returned")
+	}
+	select {
+	case <-entered:
+		t.Fatal("started another compact after cancellation")
+	default:
+	}
+}
