+func TestIdleCompactionSubdirAndCancellation(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite"} {
+		t.Run(backend, func(t *testing.T) {
+			m := idleTestMeta(t, backend)
+			outside := idleTestFile(t, m, RootInode, "outside", 3)
+			var dir Ino
+			if st := m.Mkdir(Background(), RootInode, "scope", 0700, 0, 0, &dir, nil); st != 0 {
+				t.Fatal(st)
+			}
+			inside := idleTestFile(t, m, dir, "inside", 3)
+			m.chroot(dir)
+			if st := m.compactIdleChunks(Background()); st != 0 {
+				t.Fatal(st)
+			}
+			if n := idleRecords(t, m, outside); n != 3 {
+				t.Fatalf("escaped subdir: %d", n)
+			}
+			if n := idleRecords(t, m, inside); n != 1 {
+				t.Fatalf("inside not compacted: %d", n)
+			}
+			_ = idleTestFile(t, m, dir, "cancel-a", 3)
+			_ = idleTestFile(t, m, dir, "cancel-b", 3)
+			ctx := Background()
+			var calls int
+			m.OnMsg(CompactChunk, func(...interface{}) error { calls++; ctx.Cancel(); return nil })
+			_ = m.compactIdleChunks(ctx)
+			if calls != 1 {
+				t.Fatalf("continued after cancellation: %d", calls)
+			}
+		})
+	}
+}
+
+func TestIdleCompactionScheduler(t *testing.T) {
+	for _, mode := range []string{"disabled", "readonly", "no-bgjob", "enabled"} {
+		t.Run(mode, func(t *testing.T) {
+			m := idleTestMeta(t, "memkv")
+			inode := idleTestFile(t, m, RootInode, "cold", 3)
+			m.conf.CompactInterval = time.Second
+			m.conf.ReadOnly = mode == "readonly"
+			m.conf.NoBGJob = mode == "no-bgjob"
+			if mode == "disabled" {
+				m.conf.CompactInterval = 0
+			}
+			ctx := Background()
+			m.sessCtx = ctx
+			var calls atomic.Int32
+			signal := make(chan struct{}, 1)
+			m.OnMsg(CompactChunk, func(...interface{}) error {
+				calls.Add(1)
+				select {
+				case signal <- struct{}{}:
+				default:
+				}
+				return nil
+			})
+			m.startIdleCompaction(ctx)
+			if mode == "enabled" {
+				select {
+				case <-signal:
+				case <-time.After(5 * time.Second):
+					t.Error("scheduler did not revisit idle file")
+				}
+			} else {
+				select {
+				case <-signal:
+					t.Error("disabled scheduler ran")
+				case <-time.After(1400 * time.Millisecond):
+				}
+			}
+			ctx.Cancel()
+			m.sessWG.Wait()
+			if mode == "enabled" {
+				if calls.Load() != 1 || idleRecords(t, m, inode) != 1 {
+					t.Fatal("enabled pass did not finish")
+				}
+			} else if calls.Load() != 0 || idleRecords(t, m, inode) != 3 {
+				t.Fatal("disabled pass changed file")
+			}
+		})
+	}
+}
+
+func TestIdleCompactionThrottle(t *testing.T) {
+	for _, backend := range []string{"memkv", "sqlite"} {
+		t.Run(backend, func(t *testing.T) {
+			m := idleTestMeta(t, backend)
+			const key = "lastIdleCompactRoot1"
+			for _, tc := range []struct {
+				now  int64
+				want bool
+			}{{1000000, true}, {1000001, false}, {1002000, true}} {
+				ok, err := m.en.setIfSmall(key, tc.now, 1000)
+				if err != nil || ok != tc.want {
+					t.Fatalf("claim at %d: ok=%v err=%v", tc.now, ok, err)
+				}
+			}
+		})
+	}
+}
