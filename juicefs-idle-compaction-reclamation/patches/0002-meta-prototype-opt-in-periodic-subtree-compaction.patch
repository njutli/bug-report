+// startIdleCompaction is opt-in: namespace scans and object rewrites are not free.
+// Re-discovery comes from durable chunk metadata, not an in-memory retry queue.
+func (m *baseMeta) startIdleCompaction(ctx Context) {
+	if m.conf.CompactInterval <= 0 || m.conf.ReadOnly || m.conf.NoBGJob {
+		return
+	}
+	m.sessWG.Add(1)
+	go func() {
+		defer m.sessWG.Done()
+		interval := m.conf.CompactInterval
+		if interval < time.Second {
+			interval = time.Second
+		}
+		for {
+			timer := time.NewTimer(utils.JitterIt(interval))
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+			if ctx.Canceled() {
+				return
+			}
+			// This is a best-effort throttle, not a distributed lease. A pass
+			// longer than interval, or overlapping subdir mounts, can overlap.
+			key := fmt.Sprintf("lastIdleCompactRoot%d", m.root)
+			ok, err := m.en.setIfSmall(key, time.Now().UnixMilli(), interval.Milliseconds())
+			if err != nil {
+				logger.Warnf("Idle compaction throttle: %s", err)
+				continue
+			}
+			if ok {
+				start := time.Now()
+				st := m.compactIdleChunks(ctx)
+				logger.Infof("Idle compaction traversal root=%d duration=%s status=%s", m.root, time.Since(start), st)
+			}
+		}
+	}()
+}
+
+// compactIdleChunks makes one serial, non-force attempt per reachable chunk.
+// Busy or failed chunks remain discoverable on the next pass, including after
+// a client restart. A chunk with >maxCompactSlices may require several passes.
+// It intentionally reuses walk (as Compact does), not a streaming SQL read
+// transaction held open while workers need to write the same chunk table.
+func (m *baseMeta) compactIdleChunks(ctx Context) syscall.Errno {
+	if ctx.Canceled() {
+		return syscall.EINTR
+	}
+	var attr Attr
+	if st := m.GetAttr(ctx, m.root, &attr); st != 0 {
+		return st
+	}
+	return m.walk(ctx, m.root, "", &attr, func(ctx Context, inode Ino, _ string, attr *Attr) {
+		if attr.Typ != TypeFile {
+			return
+		}
+		for i := uint64(0); i < (attr.Length+ChunkSize-1)/ChunkSize; i++ {
+			if ctx.Canceled() {
+				return
+			}
+			// Existing admission/CAS rules still apply. Cancellation prevents
+			// new work; it cannot interrupt an in-flight object callback.
+			m.compactChunk(inode, uint32(i), false, false, int(attr.Tier))
+		}
+	})
+}
+
