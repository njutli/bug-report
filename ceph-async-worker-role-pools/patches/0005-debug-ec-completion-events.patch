+// T084 functional instrument only. No wire/storage changes; default OFF.
+// The external capture manifest binds FSID, boot, PID/start and binary hashes.
+namespace {
+struct T084Key {
+  string pg, object, reqid, version;
+  uint64_t tid, interval;
+  pg_shard_t primary;
+  ceph::t085::RequestRef observed;
+};
+using T084Ref = std::shared_ptr<const T084Key>;
+
+template<typename T> string t084_string(const T& value) {
+  std::ostringstream out;
+  out << value;
+  return out.str();
+}
+
+bool t085_enabled() noexcept {
+#ifdef WITH_LTTNG
+  return tracepoint_enabled(osd,t085_message);
+#else
+  return false;
+#endif
+}
