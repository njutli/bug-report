+void t085_sink(const ceph::t085::Event& e,uint64_t seq) noexcept {
+#ifdef WITH_LTTNG
+  try {
+    ceph::JSONFormatter f(false);f.open_object_section("record");
+    f.dump_unsigned("schema",3);f.dump_string("stage",e.stage);f.dump_unsigned("seq",seq);
+    f.dump_string("sampling_rule",ceph::t085::sampling_rule);
+    f.dump_unsigned("sampling_denominator",ceph::t085::sampling_denominator);
+    f.dump_int("pid",getpid());f.dump_int("linux_tid",syscall(SYS_gettid));
+    f.dump_int("event_linux_tid",e.event_tid);
+    f.dump_unsigned("mono_low_ns",e.low);f.dump_unsigned("mono_high_ns",e.high);
+    f.dump_int("osd",e.osd);f.dump_int("shard",e.shard);
+    f.dump_int("peer_osd",e.peer_osd);f.dump_int("peer_shard",e.peer_shard);
+    f.dump_bool("local",e.osd==e.peer_osd && e.shard==e.peer_shard);
+    f.dump_bool("committed",e.committed);f.dump_bool("applied",e.applied);
+    if (e.request) {
+      const auto& r=*e.request;
+      f.dump_string("fsid",r.fsid);f.dump_int("pool",r.pool);f.dump_string("namespace",r.nspace);
+      f.dump_string("pg",r.pg);f.dump_string("object",r.object);f.dump_string("reqid",r.reqid);
+      f.dump_string("version",r.version);f.dump_unsigned("ec_tid",r.tid);f.dump_unsigned("interval",r.interval);
+      f.dump_int("primary_osd",r.primary_osd);f.dump_int("primary_shard",r.primary_shard);
+    }
+    auto socket=[&](const ceph::t085::SocketInfo& s) {
+      f.dump_unsigned("connection_id",s.connection);f.dump_unsigned("socket_epoch",s.epoch);
+      f.dump_unsigned("message_seq",s.seq);f.dump_int("protocol",s.protocol);f.dump_int("fd",s.fd);
+      f.dump_int("priority",s.priority);f.dump_string("local_endpoint",s.local);f.dump_string("peer_endpoint",s.peer);
+      f.dump_bool("tcp_info_valid",s.tcp_valid);f.dump_unsigned("tcp_rtt_us",s.rtt_us);
+      f.dump_unsigned("tcp_unacked",s.unacked);f.dump_unsigned("tcp_total_retrans",s.retrans);
+      f.dump_unsigned("tcp_snd_cwnd",s.cwnd);f.dump_int("socket_outq_bytes",s.outq_bytes);
+      f.dump_unsigned("socket_snapshot_low_ns",s.snapshot_low);f.dump_unsigned("socket_snapshot_high_ns",s.snapshot_high);
+      f.dump_unsigned("pending_send_calls",s.send_calls);f.dump_unsigned("pending_partial_calls",s.partial_calls);
+      f.dump_unsigned("pending_zero_calls",s.zero_calls);
+    };
+    if (e.message) {
+      socket(e.message->socket);f.dump_string("direction",e.message->reply?"reply":"request");
+    } else if (e.receive && e.receive->low) {
+      auto info=ceph::t085::inspect_socket(e.receive->fd);
+      info.connection=e.receive->connection;info.epoch=e.receive->epoch;
+      info.seq=e.receive->seq;info.protocol=e.receive->protocol;socket(info);
+      f.dump_unsigned("recv_complete_low_ns",e.receive->low);
+      f.dump_unsigned("recv_complete_high_ns",e.receive->high);
+      f.dump_int("recv_complete_linux_tid",e.receive->tid);
+    }
+    auto pending=[&](const char* name,const std::vector<ceph::t085::Shard>* shards) {
+      if (!shards) return;
+      f.open_array_section(name);
+      for (const auto& shard:*shards) {
+        f.open_object_section("shard");f.dump_int("osd",shard.osd);f.dump_int("shard",shard.shard);f.close_section();
+      }
+      f.close_section();
+    };
+    pending("pending_commit",e.pending_commit);pending("pending_apply",e.pending_apply);
+    f.close_section();std::ostringstream out;f.flush(out);const auto record=out.str();
+    if (record.size()>4096) {ceph::t085::fault("observer_record_too_large");return;}
+    tracepoint(osd,t085_message,record.c_str());
+  } catch (...) {ceph::t085::fault("observer_encode_error");}
+#endif
+}
