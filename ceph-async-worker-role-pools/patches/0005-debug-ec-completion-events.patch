+T084Ref t084_key(ECBackend* backend, const hobject_t& object,
+                ceph_tid_t tid, const osd_reqid_t& reqid,
+                const eversion_t& version) noexcept {
+  if (!t084_enabled()) return {};
+  try {
+    if (ceph::t085::enabled() && ceph::t085::selected(object.pool,object.nspace,object.oid.name)) {
+      auto* parent=backend->get_parent();
+      auto r=std::make_shared<ceph::t085::Request>();
+      r->fsid=t084_string(backend->get_osdmap()->get_fsid());
+      r->pg=t084_string(parent->get_info().pgid.pgid);r->object=object.oid.name;
+      r->reqid=t084_string(reqid);r->version=t084_string(version);r->tid=tid;
+      r->interval=parent->get_interval_start_epoch();r->pool=object.pool;r->nspace=object.nspace;
+      r->primary_osd=parent->primary_shard().osd;r->primary_shard=parent->primary_shard().shard.id;
+      return std::make_shared<T084Key>(T084Key{r->pg,t084_string(object),r->reqid,r->version,
+        tid,r->interval,parent->primary_shard(),std::move(r)});
+    }
+    static const string ns = [] {
+      const char* value = std::getenv("CEPH_T084_TRACE_NAMESPACE");
+      return value ? string(value) : string();
+    }();
+    static const string prefix = [] {
+      const char* value = std::getenv("CEPH_T084_TRACE_PREFIX");
+      return value ? string(value) : string();
+    }();
+    if (ns.size() < 8 || prefix.size() < 16 || object.nspace != ns ||
+        object.oid.name.compare(0, prefix.size(), prefix) != 0) return {};
+    auto* parent = backend->get_parent();
+    return std::make_shared<T084Key>(T084Key{
+      t084_string(parent->get_info().pgid.pgid), t084_string(object),
+      t084_string(reqid), t084_string(version), tid,
+      parent->get_interval_start_epoch(), parent->primary_shard(), {}});
+  } catch (...) {
+    // An incomplete trace must fail capture acceptance, not the storage op.
+    if (ceph::t085::enabled()) ceph::t085::fault("observer_ec_identity_error");
+    return {};
+  }
+}
+
+void t084_emit(const T084Ref& key, const char* stage, pg_shard_t node,
+               pg_shard_t peer, const Message* message = nullptr,
+               const set<pg_shard_t>* commits = nullptr,
+               const set<pg_shard_t>* applies = nullptr,
+               bool committed = false, bool applied = false) noexcept {
+#ifdef WITH_LTTNG
+  if (!key || !t084_enabled()) return;
+  if (key->observed) {
+    try {
+      ceph::t085::Event e;e.stage=stage;e.request=key->observed.get();
+      e.osd=node.osd;e.shard=node.shard.id;e.peer_osd=peer.osd;e.peer_shard=peer.shard.id;
+      e.committed=committed;e.applied=applied;
+      if (message) e.receive=&message->t085_receive;
+      std::vector<ceph::t085::Shard> c,a;
+      if (commits) {for (auto shard:*commits) c.push_back({shard.osd,shard.shard.id});e.pending_commit=&c;}
+      if (applies) {for (auto shard:*applies) a.push_back({shard.osd,shard.shard.id});e.pending_apply=&a;}
+      ceph::t085::emit(e);
+    } catch (...) {ceph::t085::fault("observer_ec_event_error");}
+    return;
+  }
+  static std::atomic<uint64_t> sequence{0};
+  const auto seq = sequence.fetch_add(1, std::memory_order_relaxed);
+  if (seq >= 4096) {
+    if (seq == 4096)
+      tracepoint(osd, t084_ec_write, "{\"schema\":1,\"stage\":\"overflow\"}");
+    return;
+  }
+  try {
+    timespec mono{}, wall_before{}, wall_after{};
+    if (clock_gettime(CLOCK_REALTIME, &wall_before) ||
+        clock_gettime(CLOCK_MONOTONIC, &mono) ||
+        clock_gettime(CLOCK_REALTIME, &wall_after)) {
+      tracepoint(osd, t084_ec_write, "{\"schema\":1,\"stage\":\"clock_error\"}");
+      return;
+    }
+    auto ns = [](const timespec& ts) -> uint64_t {
+      return uint64_t(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+    };
+    ceph::JSONFormatter f(false);
+    f.open_object_section("record");
+    f.dump_unsigned("schema", 1);
+    f.dump_string("stage", stage);
+    f.dump_unsigned("seq", seq);
+    f.dump_int("pid", getpid());
+    f.dump_string("pg", key->pg);
+    f.dump_string("object", key->object);
+    f.dump_string("reqid", key->reqid);
+    f.dump_string("version", key->version);
+    f.dump_unsigned("ec_tid", key->tid);
+    f.dump_unsigned("interval", key->interval);
+    f.dump_int("primary_osd", key->primary.osd);
+    f.dump_int("primary_shard", key->primary.shard.id);
+    f.dump_int("osd", node.osd);
+    f.dump_int("shard", node.shard.id);
+    f.dump_int("peer_osd", peer.osd);
+    f.dump_int("peer_shard", peer.shard.id);
+    f.dump_bool("local", peer == node);
+    f.dump_bool("committed", committed);
+    f.dump_bool("applied", applied);
+    f.dump_unsigned("mono_ns", ns(mono));
+    f.dump_unsigned("wall_before_ns", ns(wall_before));
+    f.dump_unsigned("wall_after_ns", ns(wall_after));
+    if (message) {
+      auto stamp = [](const utime_t& time) -> uint64_t {
+        return uint64_t(time.sec()) * 1000000000ULL + time.nsec();
+      };
+      f.dump_unsigned("recv_ns", stamp(message->get_recv_stamp()));
+      f.dump_unsigned("recv_complete_ns", stamp(message->get_recv_complete_stamp()));
+      f.dump_unsigned("dispatch_ns", stamp(message->get_dispatch_stamp()));
+    }
+    auto pending = [&](const char* name, const set<pg_shard_t>* shards) {
+      if (!shards) return;
+      f.open_array_section(name);
+      for (auto shard : *shards) {
+        f.open_object_section("shard");
+        f.dump_int("osd", shard.osd);
+        f.dump_int("shard", shard.shard.id);
+        f.close_section();
+      }
+      f.close_section();
+    };
+    pending("pending_commit", commits);
+    pending("pending_apply", applies);
+    f.close_section();
+    std::ostringstream out;
+    f.flush(out);
+    const string record = out.str();
+    if (record.size() > 8192) {
+      tracepoint(osd, t084_ec_write, "{\"schema\":1,\"stage\":\"record_too_large\"}");
+      return;
+    }
+    tracepoint(osd, t084_ec_write, record.c_str());
+  } catch (...) {
+    tracepoint(osd, t084_ec_write, "{\"schema\":1,\"stage\":\"encode_error\"}");
+  }
+#endif
+}
