diff --git a/src/msg/async/T088WorkerPolicy.h b/src/msg/async/T088WorkerPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..bd8b3a4bd7590c8bd1f29257a2a4ee65676ac1e4
--- /dev/null
+++ b/src/msg/async/T088WorkerPolicy.h
@@ -0,0 +1,130 @@
+// Configurable connection placement. No observers or live connection migration.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <limits>
+#include <stdexcept>
+#include <string_view>
+#include <utility>
+
+namespace t088 {
+enum class Role : unsigned { public_data, cluster_data, auxiliary, public_local };
+constexpr unsigned max_workers = 24;
+constexpr unsigned roles = 4;
+
+struct Config {
+  bool enabled = false;
+  unsigned public_weight = 1;
+  unsigned other_weight = 2;
+  bool operator==(const Config& b) const {
+    return enabled == b.enabled && public_weight == b.public_weight &&
+           other_weight == b.other_weight;
+  }
+};
+
+inline unsigned weight(std::string_view text, unsigned fallback) {
+  if (text.empty()) return fallback;
+  unsigned result = 0;
+  for (char c : text) {
+    if (c < '0' || c > '9' || result > 1000)
+      throw std::invalid_argument("T088 weights must be integers in 1..1000");
+    result = result * 10 + unsigned(c - '0');
+  }
+  if (!result || result > 1000)
+    throw std::invalid_argument("T088 weights must be integers in 1..1000");
+  return result;
+}
+
+inline Config config(std::string_view mode, std::string_view pub = {},
+                     std::string_view other = {}) {
+  if (mode.empty() || mode == "0") return {};
+  if (mode != "1") throw std::invalid_argument("T088 policy must be unset, 0 or 1");
+  return {true, weight(pub, 1), weight(other, 2)};
+}
+
+inline void validate(Config c, bool osd, std::string_view transport, unsigned n) {
+  if (c.enabled && (!osd || transport != "posix" || n < 2 || n > max_workers ||
+                    !c.public_weight || c.public_weight > 1000 ||
+                    !c.other_weight || c.other_weight > 1000))
+    throw std::invalid_argument("T088 requires OSD/posix/2..24 workers and valid weights");
+}
+
+inline unsigned public_workers(Config c, unsigned n) {
+  validate(c, true, "posix", n);
+  if (!c.enabled) throw std::logic_error("T088 pools requested in baseline mode");
+  return std::clamp(n * c.public_weight / (c.public_weight + c.other_weight), 1u, n - 1);
+}
+
+inline Role role(bool osd_messenger, std::string_view name, bool local = false) {
+  if (osd_messenger && name == "client")
+    return local ? Role::public_local : Role::public_data;
+  if (!local && osd_messenger && name == "cluster") return Role::cluster_data;
+  return Role::auxiliary;
+}
+
+// All calls are serialized by NetworkStack::pool_spin. Counts are live worker
+// reservations, not byte/CPU load. Failed accepts must release their reservation.
+// Loopbacks/heartbeats/bootstrap do not inflate cluster_data/public_data counts.
+class Allocator {
+  Config policy;
+  unsigned count = 0, public_count = 0;
+  std::array<std::array<unsigned, max_workers>, roles> active{};
+  std::array<unsigned, roles> cursor{};
+
+  std::pair<unsigned, unsigned> range(Role r) const {
+    if (!count || static_cast<unsigned>(r) >= roles)
+      throw std::logic_error("T088 unconfigured allocator or invalid role");
+    return (r == Role::public_data || r == Role::public_local)
+      ? std::make_pair(0u, public_count) : std::make_pair(public_count, count);
+  }
+ public:
+  void configure(Config c, unsigned n) {
+    const unsigned p = public_workers(c, n);
+    if (count && (!(policy == c) || count != n))
+      throw std::logic_error("T088 shared stack policy cannot change in place");
+    policy = c; count = n; public_count = p;
+  }
+  unsigned acquire(Role r, const std::array<unsigned, max_workers>& references) {
+    auto [lo, hi] = range(r);
+    const auto k = static_cast<unsigned>(r);
+    unsigned best = lo + cursor[k] % (hi - lo);
+    for (unsigned step = 1; step < hi - lo; ++step) {
+      const unsigned i = lo + (cursor[k] + step) % (hi - lo);
+      if (active[k][i] < active[k][best] ||
+          (active[k][i] == active[k][best] && references[i] < references[best])) best = i;
+    }
+    if (active[k][best] == std::numeric_limits<unsigned>::max())
+      throw std::overflow_error("T088 reservation counter overflow");
+    ++active[k][best];
+    cursor[k] = (best - lo + 1) % (hi - lo);
+    return best;
+  }
+  void release(Role r, unsigned worker) {
+    auto [lo, hi] = range(r);
+    const auto k = static_cast<unsigned>(r);
+    if (worker < lo || worker >= hi || !active[k][worker])
+      throw std::logic_error("T088 invalid or duplicate reservation release");
+    --active[k][worker];
+  }
+  // Protocol replacement keeps the existing connection but adopts the new
+  // socket's worker. Its temporary connection has already released its own
+  // reservation. Move this surviving reservation, including same-worker cases.
+  void transfer(Role r, unsigned from, unsigned to) {
+    auto [lo, hi] = range(r);
+    const auto k = static_cast<unsigned>(r);
+    if (from < lo || from >= hi || to < lo || to >= hi || !active[k][from])
+      throw std::logic_error("T088 invalid reservation transfer");
+    if (from == to) return;
+    if (active[k][to] == std::numeric_limits<unsigned>::max())
+      throw std::overflow_error("T088 reservation transfer overflow");
+    --active[k][from];
+    ++active[k][to];
+  }
+  unsigned reservations(Role r, unsigned worker) const {
+    range(r);
+    if (worker >= count) throw std::out_of_range("T088 worker");
+    return active[static_cast<unsigned>(r)][worker];
+  }
+};
+} // namespace t088
