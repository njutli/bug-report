+void NetworkStack::t088_configure(t088::Config policy)
+{
+  std::lock_guard<decltype(pool_spin)> guard(pool_spin);
+  t088_allocator.configure(policy, workers.size());
+}
+
+Worker* NetworkStack::t088_get_worker(t088::Role role)
+{
+  std::lock_guard<decltype(pool_spin)> guard(pool_spin);
+  std::array<unsigned, t088::max_workers> refs{};
+  for (unsigned i = 0; i < workers.size(); ++i)
+    refs[i] = workers[i]->references.load();
+  Worker *selected = workers[t088_allocator.acquire(role, refs)];
+  ++selected->references;
+  return selected;
+}
+
+void NetworkStack::t088_release_worker(Worker *worker, t088::Role role)
+{
+  std::lock_guard<decltype(pool_spin)> guard(pool_spin);
+  ceph_assert(worker->id < workers.size() && workers[worker->id] == worker);
+  t088_allocator.release(role, worker->id);
+  worker->release_worker();
+}
+
+void NetworkStack::t088_transfer_worker(Worker *from, Worker *to, t088::Role role)
+{
+  std::lock_guard<decltype(pool_spin)> guard(pool_spin);
+  ceph_assert(from->id < workers.size() && workers[from->id] == from);
+  ceph_assert(to->id < workers.size() && workers[to->id] == to);
+  t088_allocator.transfer(role, from->id, to->id);
+  if (from != to) {
+    from->release_worker();
+    ++to->references;
+  }
+}
