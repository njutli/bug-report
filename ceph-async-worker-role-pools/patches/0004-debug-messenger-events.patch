+namespace {
+std::string t085_endpoint(int fd,bool peer) {
+  sockaddr_storage address{};socklen_t size=sizeof(address);
+  int rc=peer ? getpeername(fd,reinterpret_cast<sockaddr*>(&address),&size)
+              : getsockname(fd,reinterpret_cast<sockaddr*>(&address),&size);
+  if (rc) return "UNKNOWN";
+  char text[INET6_ADDRSTRLEN]{};uint16_t port=0;
+  if (address.ss_family==AF_INET) {
+    auto* a=reinterpret_cast<sockaddr_in*>(&address);
+    if (!inet_ntop(AF_INET,&a->sin_addr,text,sizeof(text))) return "UNKNOWN";
+    port=ntohs(a->sin_port);
+  } else if (address.ss_family==AF_INET6) {
+    auto* a=reinterpret_cast<sockaddr_in6*>(&address);
+    if (!inet_ntop(AF_INET6,&a->sin6_addr,text,sizeof(text))) return "UNKNOWN";
+    port=ntohs(a->sin6_port);
+  } else return "UNKNOWN";
+  return std::string(text)+":"+std::to_string(port);
+}
+void t085_tcp(ceph::t085::SocketInfo& info) {
+  info.snapshot_low=ceph::t085::mono();
+  tcp_info tcp{};socklen_t length=sizeof(tcp);
+  info.tcp_valid=getsockopt(info.fd,IPPROTO_TCP,TCP_INFO,&tcp,&length)==0;
+  if (info.tcp_valid) {
+    info.rtt_us=tcp.tcpi_rtt;info.unacked=tcp.tcpi_unacked;
+    info.retrans=tcp.tcpi_total_retrans;info.cwnd=tcp.tcpi_snd_cwnd;
+  }
+  if (ioctl(info.fd,SIOCOUTQ,&info.outq_bytes)) info.outq_bytes=-1;
+  info.snapshot_high=ceph::t085::mono();
+}
+}
+
+ceph::t085::SocketInfo ceph::t085::inspect_socket(int fd) noexcept {
+  SocketInfo info;info.fd=fd;
+  try {info.local=t085_endpoint(fd,false);info.peer=t085_endpoint(fd,true);t085_tcp(info);}
+  catch (...) {fault("observer_socket_metadata_error");}
+  return info;
+}
+
+void AsyncConnection::t085_frame(Message* message) noexcept {
+  auto context=message->t085_context;
+  if (!context || !ceph::t085::enabled()) return;
+  const uint64_t frame_ready=ceph::t085::mono();
+  const int frame_tid=ceph::t085::current_tid();
+  try {
+    if (!cs) {ceph::t085::fault("observer_missing_socket");return;}
+    if (!t085_sender) t085_sender=std::make_unique<T085Sender>(t085_epoch);
+    auto& socket=context->socket;
+    socket.connection=t085_connection;socket.epoch=t085_epoch;
+    socket.seq=message->get_seq();socket.protocol=msgr2?2:1;socket.fd=cs.fd();
+    socket.priority=message->get_priority();
+    socket.local=t085_endpoint(socket.fd,false);socket.peer=t085_endpoint(socket.fd,true);
+    t085_tcp(socket);
+    const char* stages[3]={"enqueue","dequeue","encode_ready"};
+    for (unsigned i=0;i<3;++i) {
+      if (!context->stamps[i] || (i && context->stamps[i]<context->stamps[i-1])) {
+        ceph::t085::fault("observer_missing_or_inverted_sender_boundary");return;
+      }
+      ceph::t085::message_event(context,stages[i],context->stamps[i],context->stamps[i],context->stamp_tids[i]);
+    }
+    if (context->eager_ready) ceph::t085::message_event(context,"eager_encode_ready",context->eager_ready,context->eager_ready,context->eager_tid);
+    const uint64_t token=t085_sender->token++;
+    if (!t085_sender->frames.emplace(token,context).second) {
+      ceph::t085::fault("observer_duplicate_frame");return;
+    }
+    t085_sender->ledger.frame(token,outgoing_bl.length());
+    ceph::t085::message_event(context,"frame_ready",frame_ready,frame_ready,frame_tid);
+  } catch (...) {ceph::t085::fault("observer_frame_accounting_error");}
+}
+
+void AsyncConnection::t085_sent(uint64_t before,uint64_t after,int64_t rc,uint64_t low,uint64_t high) noexcept {
+  if (!t085_sender) return;
+  try {
+    // Calls observed while each selected frame is pending, including mixed
+    // control/unselected traffic ahead of it; not individual sendmsg counts.
+    for (auto& frame:t085_sender->frames) {
+      auto& info=frame.second->socket;++info.send_calls;
+      if (rc>0 && after>0) ++info.partial_calls;
+      if (rc==0 && before>0) ++info.zero_calls;
+    }
+    for (auto completed:t085_sender->ledger.sent(t085_epoch,before,after,rc,low,high)) {
+      auto found=t085_sender->frames.find(completed.token);
+      if (found==t085_sender->frames.end()) {ceph::t085::fault("observer_unknown_frame");return;}
+      t085_tcp(found->second->socket);
+      ceph::t085::message_event(found->second,"socket_accept",completed.low,completed.high);
+      t085_sender->frames.erase(found);
+    }
+  } catch (...) {ceph::t085::fault("observer_socket_error_or_accounting_failure");}
+}
+
+void AsyncConnection::t085_received(Message* message) noexcept {
+  if (!ceph::t085::enabled() ||
+      (message->get_type()!=MSG_OSD_EC_WRITE && message->get_type()!=MSG_OSD_EC_WRITE_REPLY)) return;
+  auto& r=message->t085_receive;
+  r.low=r.high=ceph::t085::mono();r.connection=t085_connection;r.epoch=t085_epoch;
+  r.tid=ceph::t085::current_tid();
+  r.seq=message->get_seq();r.protocol=msgr2?2:1;r.fd=cs?cs.fd():-1;
+}
+
+void AsyncConnection::t085_reset(const char* reason) noexcept {
+  if (t085_sender && ceph::t085::enabled()) ceph::t085::fault(reason);
+  t085_sender.reset();++t085_epoch;
+}
