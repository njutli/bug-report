From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Li Lingfeng <a1151488180@gmail.com>
Date: Tue, 29 Sep 2026 16:41:16 +0800
Subject: [PATCH 1/2] meta: retry ordinary compaction after busy admission
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Ordinary compaction requests from Read/Write are discarded when the client
admission gate or the same chunk is busy. If IO stops, completing existing
compactions does not revisit those requests and historical references can
remain until another trigger happens.

Coalesce busy ordinary requests by the existing chunk admission key. When
a compaction releases its slot, reserve it for one eligible pending request
under the same mutex and then dispatch that request. Re-read metadata and
run the existing ordinary batch, retaining the original concurrency gate,
batch selection, object callback and prefix/CAS replacement.

An ordinary admission supersedes older queued requests for that key. A
synchronous max-slices check must not discard a queued ordinary request
when its own threshold is not met. Release a slot only once before forced
recursion so unwinding cannot remove a reservation transferred to a retry.

Discard queued callbacks at session cancellation. This is a process-local
retry of busy admission, not persistent recovery of pre-existing history.
It does not add a scan, timer, configuration option, metadata format, or
automatic retry of an already-admitted operation that fails. Pending memory
is proportional to distinct queued chunk keys, not the number of triggers.

Base: JuiceFS v1.4.1 (0b90c7db5a929ae6adc5faad948d108efd2c99f9)
---
 pkg/meta/base.go |   47 ++++++++++++++++++++++++++++++++++++++++++-----
 1 file changed, 42 insertions(+), 5 deletions(-)

diff --git a/pkg/meta/base.go b/pkg/meta/base.go
index a3a0262a5ce5b7c88b712793aca04961761908ad..777284e1de2ecd3a5e90c2d2e64af0ed73ef535d 100644
--- a/pkg/meta/base.go
+++ b/pkg/meta/base.go
@@ -283,6 +283,7 @@
 	of           *openfiles
 	removedFiles map[Ino]bool
 	compacting   map[uint64]bool
+	compactTodo  map[uint64]func()
 	maxDeleting  chan struct{}
 	dslices      chan Slice // slices to delete
 	symlinks     *symlinkCache
@@ -978,6 +979,9 @@
 	if m.sessCtx != nil {
 		m.sessCtx.Cancel()
 	}
+	m.Lock()
+	m.compactTodo = nil
+	m.Unlock()
 	m.sessWG.Wait()
 	m.stopDeleteSliceTasks()
 	logger.Infof("close session %d: %v", m.sid, err)
@@ -2812,16 +2816,51 @@
 			m.Lock()
 		}
 	} else if len(m.compacting) > 10 || m.compacting[k] {
+		// Retain one ordinary retry per chunk instead of losing a busy trigger.
+		if m.compactTodo == nil {
+			m.compactTodo = make(map[uint64]func())
+		}
+		m.compactTodo[k] = func() { m.compactChunkAdmitted(inode, indx, false, false, tierID) }
 		m.Unlock()
 		return
+	} else {
+		delete(m.compactTodo, k) // This attempt covers earlier queued triggers.
 	}
 	m.compacting[k] = true
 	m.Unlock()
-	defer func() {
+	m.compactChunkAdmitted(inode, indx, once, force, tierID)
+}
+
+// compactChunkAdmitted runs with its slot already reserved in m.compacting.
+func (m *baseMeta) compactChunkAdmitted(inode Ino, indx uint32, once, force bool, tierID int) {
+	k := uint64(inode) + (uint64(indx) << 40)
+	released := false
+	release := func() {
+		if released {
+			return
+		}
+		released = true
 		m.Lock()
 		delete(m.compacting, k)
+		if m.sessCtx != nil && m.sessCtx.Canceled() {
+			m.compactTodo = nil
+		} else if len(m.compacting) <= 10 {
+			for next, run := range m.compactTodo {
+				if !m.compacting[next] {
+					delete(m.compactTodo, next)
+					// Transfer one slot atomically; a retry must not be rejected again.
+					m.compacting[next] = true
+					go run()
+					break
+				}
+			}
+		}
 		m.Unlock()
-	}()
+	}
+	defer release()
+	if m.sessCtx != nil && m.sessCtx.Canceled() {
+		return
+	}
 
 	ss, st := m.en.doRead(Background(), inode, indx)
 	if st != 0 {
@@ -2899,9 +2938,7 @@
 	}
 
 	if force {
-		m.Lock()
-		delete(m.compacting, k)
-		m.Unlock()
+		release() // Do not release a transferred slot again when recursion unwinds.
 		m.compactChunk(inode, indx, once, force, tierID)
 	}
 }

